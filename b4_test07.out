    input: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf
    output: output/bam_isoseq_proteins_masked/genome_gmst_for_HC.flanking.gtf, output/bam_isoseq_proteins_masked/flanking_dna_value.txt
    jobid: 27
