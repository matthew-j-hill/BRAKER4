    reason: Missing output files: output/bam_isoseq_proteins_masked/braker.tsebra.gtf; Input files updated by another job: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf, output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf, output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        set -euo pipefail
        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1

        echo "[INFO] best_by_compleasm enabled: True" > logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
        echo "[INFO] mode: dual" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log

        if [ "True" != "True" ]; then
            # Disabled — pass through the raw TSEBRA output unchanged.
            echo "[INFO] run_best_by_compleasm=0; copying braker.tsebra.raw.gtf -> braker.tsebra.gtf" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
            cp output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf output/bam_isoseq_proteins_masked/braker.tsebra.gtf
            echo "skipped (run_best_by_compleasm=0)" > output/bam_isoseq_proteins_masked/best_by_compleasm.log
            exit 0
        fi

        # Staging area on the node-local disk
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        scratch_dir outDir "bbc_bam_isoseq_proteins_masked" "/tmp" 10 \
            "$PWD/output/bam_isoseq_proteins_masked/best_by_compleasm_tmp" 2>> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
        trap 'rm -rf -- "$SCRATCH"' EXIT
        TMP=$outDir
        if [ -z "$SCRATCH" ]; then
            # fallback: clear an earlier attempt's staging area
            rm -rf "$TMP"
            mkdir -p "$TMP"
        fi

        # ---- helper: run one best_by_compleasm pass ------------------------
        # $1 = stage label (e.g. "sr", "iso", "final")
        # $2 = path to braker.gtf for this pass
        # $3 = path to augustus.hints.gtf for this pass
        # $4 = path to genemark.gtf for this pass
        # writes: $TMP/<label>/better.gtf  (if produced)
        #         $TMP/<label>/bbc.stdout  (script stdout)
        #         $TMP/<label>/bbc_status.txt  (one line: "OK: ...",
        #             "COMPLEASM_FAILED: ..." or "FAILED: ...")
        # On a failed pass, better.gtf is discarded so pick_result falls back
        # to the input gene set; the pipeline keeps running with a warning.
        # Note: augustus.hints.aa is ALWAYS regenerated from the staged
        # augustus.hints.gtf so the protein set matches the gene set the
        # pass is asked to evaluate.
        run_pass() {
            local label="$1"
            local braker_gtf="$2"
            local aug_gtf="$3"
            local gm_gtf="$4"

            local stage="$TMP/${label}_stage"
            mkdir -p "$stage/GeneMark-ETP"
            cp "$braker_gtf" "$stage/braker.gtf"
            cp "$aug_gtf"    "$stage/augustus.hints.gtf"
            cp "$gm_gtf"     "$stage/GeneMark-ETP/genemark.gtf"

            # Generate braker.aa from staged braker.gtf
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
                -g output/bam_isoseq_proteins_masked/genome.fa \
                -f "$stage/braker.gtf" \
                -o "$stage/braker" \
                2>> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log || true

            if [ ! -f "$stage/braker.aa" ]; then
                echo "[WARN] $label: could not generate braker.aa, skipping pass" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
                return 1
            fi

            # Generate augustus.hints.aa from staged augustus.hints.gtf so
            # the protein set is consistent with the GTF.
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
                -g output/bam_isoseq_proteins_masked/genome.fa \
                -f "$stage/augustus.hints.gtf" \
                -o "$stage/augustus.hints" \
                2>> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log || true

            if [ ! -f "$stage/augustus.hints.aa" ]; then
                echo "[WARN] $label: could not generate augustus.hints.aa, skipping pass" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
                return 1
            fi

            mkdir -p "$TMP/$label"
            local status_file="$TMP/$label/bbc_status.txt"
            local rc=0
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/best_by_compleasm.py \
                -m "$TMP/$label" \
                -d "$stage" \
                -g output/bam_isoseq_proteins_masked/genome.fa \
                -t 8 \
                -p eukaryota_odb12 \
                -L /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages \
                -s "$status_file" \
                > "$TMP/$label/bbc.stdout" 2>> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log || rc=$?

            # The script writes its own status line; if it died before that
            # (killed, OOM, import error), record the exit code instead.
            if [ ! -s "$status_file" ]; then
                echo "FAILED: best_by_compleasm.py exited with code $rc without writing a status line" > "$status_file"
            fi
            local status
            status=$(head -n 1 "$status_file")
            echo "[INFO] $label: status: $status" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log

            case "$status" in
                OK*)
                    if [ -s "$TMP/$label/better.gtf" ]; then
                        echo "[INFO] $label: produced better.gtf" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
                    else
                        echo "[INFO] $label: original was already best; no better.gtf" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
                    fi
                    ;;
                *)
                    # Never use a better.gtf left behind by a failed run
                    rm -f "$TMP/$label/better.gtf"
                    echo "[WARNING] $label: best_by_compleasm failed, keeping the TSEBRA gene set unchanged. $status" | tee -a logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log >&2
                    ;;
            esac
            return 0
        }

        # ---- pick a result file from a pass --------------------------------
        # If better.gtf exists, prefer it; otherwise fall back to the input.
        pick_result() {
            local label="$1"
            local fallback="$2"
            local target="$3"
            if [ -s "$TMP/$label/better.gtf" ]; then
                cp "$TMP/$label/better.gtf" "$target"
            else
                cp "$fallback" "$target"
            fi
        }

        # ---------------------------------------------------------------- main
        echo "[INFO] running best_by_compleasm" >> logs/bam_isoseq_proteins_masked/best_by_compleasm/best_by_compleasm.log
        run_pass "single" output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf
        pick_result "single" output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf output/bam_isoseq_proteins_masked/braker.tsebra.gtf
        # First line of the log is the run status (read by generate_report.py)
        {
            echo "STATUS: $(head -n 1 "$TMP/single/bbc_status.txt")"
            grep -v '^STATUS: ' "$TMP/single/bbc.stdout" 2>/dev/null || true
        } > output/bam_isoseq_proteins_masked/best_by_compleasm.log

        # Final sanity check — ensure the output file exists
        if [ ! -f output/bam_isoseq_proteins_masked/braker.tsebra.gtf ]; then
            cp output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf output/bam_isoseq_proteins_masked/braker.tsebra.gtf
        fi

        # Clean up the staging area unless no_cleanup is set. On scratch the
        # EXIT trap removes it; with no_cleanup it is copied to the run dir.
        if [ "False" = "True" ]; then
            copy_back "$TMP" "$PWD/output/bam_isoseq_proteins_masked/best_by_compleasm_tmp"
        elif [ -z "$SCRATCH" ]; then
            rm -rf "$TMP"
        fi

        # Citations
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite tsebra "$REPORT_DIR" || true
        cite compleasm "$REPORT_DIR" || true
        cite braker_book "$REPORT_DIR" || true
        
