localrule check_bam_sorted:
    input: ../../test_data/RNAseq.bam, output/bam_isoseq_proteins_masked/genome.fa.fai
    output: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi
    log: logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
    jobid: 14
    benchmark: benchmarks/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam; Input files updated by another job: output/bam_isoseq_proteins_masked/genome.fa.fai
    wildcards: sample=bam_isoseq_proteins_masked, bam_id=RNAseq
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        # Reference names in the BAM must match the genome FASTA headers
        # (first word, as kept by prepare_genome). Otherwise GeneMark-ETP's
        # StringTie step silently produces an empty transcripts_merged.fasta
        # and fails much later (issue #76).
        bash /projects/wenglab/testtube/matthew/manual/braker4/scripts/check_bam_refs.sh ../../test_data/RNAseq.bam output/bam_isoseq_proteins_masked/genome.fa.fai 2> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log || { cat logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log >&2; exit 1; }

        # Check if BAM is already coordinate-sorted and indexable
        # Even if header says sorted, unmapped reads might be in wrong position
        IS_SORTED=false

        if samtools view -H ../../test_data/RNAseq.bam | grep -q '@HD.*SO:coordinate'; then
            echo "BAM file ../../test_data/RNAseq.bam header indicates coordinate-sorted" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log

            # Try to create a symlink and index it
            ln -sf $(readlink -f ../../test_data/RNAseq.bam) output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam 2>> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log

            # Test if we can index it
            if samtools index -c -@ 8 output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam 2>> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log; then
                echo "BAM file is properly sorted and indexable" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
                IS_SORTED=true
            else
                echo "BAM file claims to be sorted but cannot be indexed (unmapped reads in wrong position)" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
                echo "Will re-sort to fix the issue" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
                rm -f output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi
                IS_SORTED=false
            fi
        else
            echo "BAM file ../../test_data/RNAseq.bam is not coordinate-sorted" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
            IS_SORTED=false
        fi

        # If not properly sorted, re-sort
        if [ "$IS_SORTED" = "false" ]; then
            echo "Sorting BAM file..." >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log

            # Sort chunks and the sorted BAM go to the node-local disk
            source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
            BAM_ABS=$PWD/output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam
            CSI_ABS=$PWD/output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi
            scratch_dir outDir "bamsort_bam_isoseq_proteins_masked_RNAseq" "/tmp" \
                "$(need_gb 2 ../../test_data/RNAseq.bam)" "$(dirname "$BAM_ABS")" 2>> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
            # samtools sort chunks in a private dir: in the fallback (no scratch)
            # all jobs share outDir, and a fixed prefix made parallel jobs and
            # retries collide on sort.NNNN.bam ('File exists')
            SORT_TMP=$(mktemp -d "$outDir/.samtools_sort_XXXXXX")
            trap 'rm -rf -- "$SCRATCH" "$SORT_TMP"' EXIT
            SORTED_BAM="$outDir/RNAseq.sorted.bam"

            # Sort with parallel threads (fixes BRAKER issue: was -@ 0)
            samtools sort \
                -@ 8 \
                -T "$SORT_TMP/sort" \
                -o "$SORTED_BAM" \
                ../../test_data/RNAseq.bam \
                2>> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log

            echo "Sorting complete" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log

            # Create index
            samtools index -c -@ 8 "$SORTED_BAM" 2>> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
            echo "Indexing complete" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
            if [ -n "$SCRATCH" ]; then
                cp "$SORTED_BAM" "$BAM_ABS.tmp"
                mv "$BAM_ABS.tmp" "$BAM_ABS"
                cp "$SORTED_BAM.csi" "$CSI_ABS.tmp"
                mv "$CSI_ABS.tmp" "$CSI_ABS"
            fi
            if [ ! -s "$BAM_ABS" ] || [ ! -s "$CSI_ABS" ]; then
                echo "ERROR: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam or its .csi missing after the copy back" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
                exit 1
            fi
        fi

        # A BAM without mapped reads, or a STAR BAM whose spliced reads lack
        # the XS strand tag, passes the checks above, and GeneMark-ETP then
        # crashes hours later in parse_set.pl (Gaius-Augustus/BRAKER#719).
        # GeneMark-ETP runs StringTie, which needs XS; ET mode (bam2hints)
        # does not, so there it is only a warning.
        MAPPED=$(samtools idxstats output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam | awk '{s += $3} END {print s + 0}')
        if [ "$MAPPED" -eq 0 ]; then
            echo "ERROR: ../../test_data/RNAseq.bam contains no mapped reads. Check the aligner log and that the reads were aligned to this genome." | tee -a logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log >&2
            exit 1
        fi
        echo "Mapped reads: $MAPPED" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
        set +o pipefail    # awk stops reading after 1M alignments
        read -r N_SPL N_XS < <(samtools view -F 4 output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam | awk -F'\t' '$6 ~ /N/ {n++; if ($0 ~ /\tXS:A:[+-]/) x++} NR >= 1000000 {exit} END {print n + 0, x + 0}')
        set -o pipefail
        echo "Spliced alignments in the first 1M: $N_SPL, with XS tag: $N_XS" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
        if [ "$N_SPL" -gt 0 ] && [ "$N_XS" -eq 0 ]; then
            MSG="none of the $N_SPL spliced reads in the first 1M alignments of ../../test_data/RNAseq.bam has an XS strand tag. GeneMark-ETP's StringTie step needs it (STAR: --outSAMstrandField intronMotif; HISAT2 writes it by default)"
            if [ "dual" = "etp" ] || [ "dual" = "dual" ]; then
                echo "ERROR: $MSG. Realign, or run ET mode (leave protein_fasta empty)." | tee -a logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log >&2
                exit 1
            else
                echo "WARNING: $MSG" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
            fi
        fi

        echo "Final BAM file: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
        echo "Final index file: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi" >> logs/bam_isoseq_proteins_masked/check_bam_sorted/RNAseq.log
        
