localrule assess_completeness:
    input: output/bam_isoseq_proteins_masked/braker.aa
    output: output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt, output/bam_isoseq_proteins_masked/compleasm_proteins.log
    jobid: 43
    benchmark: benchmarks/bam_isoseq_proteins_masked/assess_completeness/assess_completeness.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt; Input files updated by another job: output/bam_isoseq_proteins_masked/braker.aa
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1
        set -euo pipefail

        echo "[INFO] ===== ASSESSING GENE SET COMPLETENESS WITH COMPLEASM =====" | tee output/bam_isoseq_proteins_masked/compleasm_proteins.log
        echo "[INFO] BUSCO lineage: eukaryota_odb12" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        echo "[INFO] Threads: 8" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        echo "[INFO] Input proteins: output/bam_isoseq_proteins_masked/braker.aa" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log

        # Count proteins
        PROTEIN_COUNT=$(grep -c "^>" output/bam_isoseq_proteins_masked/braker.aa || echo 0)
        echo "[INFO] Total proteins: $PROTEIN_COUNT" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log

        if [ $PROTEIN_COUNT -eq 0 ]; then
            echo "[WARNING] No proteins found - skipping compleasm" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
            mkdir -p output/bam_isoseq_proteins_masked/compleasm_proteins
            echo "No proteins available for assessment" > output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt
            exit 0
        fi

        # Remove output directory if it exists (compleasm requires clean directory)
        if [ -d "output/bam_isoseq_proteins_masked/compleasm_proteins" ]; then
            rm -rf output/bam_isoseq_proteins_masked/compleasm_proteins
        fi

        mkdir -p output/bam_isoseq_proteins_masked/compleasm_proteins
        mkdir -p /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages

        COMPLEASM_LINEAGE="eukaryota_odb12"
        COMPLEASM_NAME="${COMPLEASM_LINEAGE%%_*}"
        COMPLEASM_ODB="${COMPLEASM_LINEAGE#*_}"
        if [ "$COMPLEASM_ODB" = "$COMPLEASM_LINEAGE" ]; then COMPLEASM_ODB="odb12"; fi
        echo "[INFO] Running compleasm in protein mode..." | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        echo "[INFO] Library path: /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        echo "[INFO] Lineage: $COMPLEASM_NAME --odb $COMPLEASM_ODB" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log

        # compleasm_wrapper.py skips proteins >= 100,000 aa (hmmsearch limit,
        # issues #91/#92) and restores the offline fallback (issue #105).
        # A compleasm failure does not stop the pipeline, but it is recorded
        # as "COMPLEASM_FAILED: <reason>" in the summary (and so in the report).
        COMPLEASM_RUN_LOG=output/bam_isoseq_proteins_masked/compleasm_proteins.run.tmp
        COMPLEASM_RC=0
        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/compleasm_wrapper.py protein \
            -p output/bam_isoseq_proteins_masked/braker.aa \
            -l $COMPLEASM_NAME \
            --odb $COMPLEASM_ODB \
            -t 8 \
            -o output/bam_isoseq_proteins_masked/compleasm_proteins \
            -L /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages \
            2>&1 | tee "$COMPLEASM_RUN_LOG" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log || COMPLEASM_RC=$?

        # Check if summary was created (compleasm may put it in a lineage subdirectory)
        if [ ! -f output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt ]; then
            FOUND_SUMMARY=$(find output/bam_isoseq_proteins_masked/compleasm_proteins -name "summary.txt" 2>/dev/null | head -1)
            if [ -n "$FOUND_SUMMARY" ] && [ -f "$FOUND_SUMMARY" ]; then
                cp "$FOUND_SUMMARY" output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt
                echo "[INFO] Copied summary from $FOUND_SUMMARY" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
            else
                REASON=$(grep -iE 'error|exception|abort|fail|killed' "$COMPLEASM_RUN_LOG" | tail -n 1 || true)
                if [ -z "$REASON" ]; then
                    REASON=$(grep -v '^[[:space:]]*$' "$COMPLEASM_RUN_LOG" | tail -n 1 || true)
                fi
                STATUS="COMPLEASM_FAILED: compleasm exited with code $COMPLEASM_RC and wrote no summary.txt${REASON:+: $REASON}"
                echo "[WARNING] $STATUS" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log >&2
                mkdir -p output/bam_isoseq_proteins_masked/compleasm_proteins
                echo "$STATUS" > output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt
            fi
        elif [ "$COMPLEASM_RC" -ne 0 ]; then
            echo "[WARNING] compleasm exited with code $COMPLEASM_RC but wrote a summary; check it" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log >&2
            cat output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        else
            echo "[INFO] Compleasm assessment completed" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
            echo "[INFO] Summary:" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
            cat output/bam_isoseq_proteins_masked/compleasm_proteins/summary.txt | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        fi

        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/compleasm_proteins.log
        rm -f "$COMPLEASM_RUN_LOG"

        # Remove compleasm protein internal files; keep only summary.txt.
        find output/bam_isoseq_proteins_masked/compleasm_proteins -mindepth 1 -type f ! -name 'summary.txt' \
            -delete 2>/dev/null || true
        find output/bam_isoseq_proteins_masked/compleasm_proteins -mindepth 1 -type d -empty \
            -delete 2>/dev/null || true
        
