localrule busco_summary:
    input: output/bam_isoseq_proteins_masked/busco/genome/.done, output/bam_isoseq_proteins_masked/busco/proteins/.done
    output: output/bam_isoseq_proteins_masked/busco/busco_summary.txt
    log: logs/bam_isoseq_proteins_masked/busco/busco_summary.log
    jobid: 39
    benchmark: benchmarks/bam_isoseq_proteins_masked/busco_summary/busco_summary.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/busco/busco_summary.txt; Input files updated by another job: output/bam_isoseq_proteins_masked/busco/genome/.done, output/bam_isoseq_proteins_masked/busco/proteins/.done
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail
        GENOME_SUMMARY=$(find output/bam_isoseq_proteins_masked/busco/genome -name "short_summary*.txt" | head -1)
        PROTEINS_SUMMARY=$(find output/bam_isoseq_proteins_masked/busco/proteins -name "short_summary*.txt" | head -1)

        # Write combined summary
        echo "===== BUSCO Completeness Summary =====" > output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        echo "Lineage: eukaryota_odb12" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        echo "" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt

        echo "--- Genome Assembly ---" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        if [ -n "$GENOME_SUMMARY" ] && [ -f "$GENOME_SUMMARY" ]; then
            grep -E "C:|S:|D:|F:|M:|n:" "$GENOME_SUMMARY" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        else
            echo "Results not found" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        fi
        echo "" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt

        echo "--- Predicted Proteome ---" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        if [ -n "$PROTEINS_SUMMARY" ] && [ -f "$PROTEINS_SUMMARY" ]; then
            grep -E "C:|S:|D:|F:|M:|n:" "$PROTEINS_SUMMARY" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        else
            echo "Results not found" >> output/bam_isoseq_proteins_masked/busco/busco_summary.txt
        fi

        # Backstop only: busco_genome and busco_proteins each clean their own
        # working tree as soon as they finish. This catches trees left by an
        # older run whose .done files are still valid, so those rules do not
        # re-execute.
        for bmode in genome proteins; do
            find output/bam_isoseq_proteins_masked/busco/$bmode -mindepth 1 \( -type f -o -type l \) \
                ! -name 'short_summary*.txt' ! -name '.done' \
                -delete 2>/dev/null || true
            find output/bam_isoseq_proteins_masked/busco/$bmode -mindepth 1 -type d -empty \
                -delete 2>/dev/null || true
        done
        
