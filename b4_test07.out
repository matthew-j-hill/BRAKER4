        echo "[INFO] computeFlankingRegion.pl completed for output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf"
        echo "[INFO] Output written to output/bam_isoseq_proteins_masked/genome_gmst_for_HC.flanking.gtf"
        echo "[INFO] Flanking DNA value extracted: $(cat output/bam_isoseq_proteins_masked/flanking_dna_value.txt)"
        
