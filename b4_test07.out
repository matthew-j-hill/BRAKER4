localrule downsample_training_genes:
    input: output/bam_isoseq_proteins_masked/bonafide.f.gb, output/bam_isoseq_proteins_masked/bonafide.f.gtf
    output: output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb, output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf, output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gtf, output/bam_isoseq_proteins_masked/downsample_traingenes.log, output/bam_isoseq_proteins_masked/downsample_gene_count.txt
    jobid: 23
    benchmark: benchmarks/bam_isoseq_proteins_masked/downsample_training_genes/downsample_training_genes.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb; Input files updated by another job: output/bam_isoseq_proteins_masked/bonafide.f.gb, output/bam_isoseq_proteins_masked/bonafide.f.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        echo "[INFO] ===== TRAINING GENE DOWNSAMPLING ====="

        # Count genes before downsampling
        GENES_BEFORE=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.f.gb || echo 0)
        echo "[INFO] Input genes: $GENES_BEFORE"

        # Step 1: Extract gene names from the post-DIAMOND GenBank file
        echo "[INFO] Extracting non-redundant gene names..."
        cat output/bam_isoseq_proteins_masked/bonafide.f.gb | perl -ne 'if(m/\/gene=\"(\S+)\"/){print "$1\n";}' | sort -u > output/bam_isoseq_proteins_masked/clean_genes.lst

        # Step 2: Filter the GTF to keep only those genes
        echo "[INFO] Filtering GTF for non-redundant genes..."
        grep -f output/bam_isoseq_proteins_masked/clean_genes.lst -F output/bam_isoseq_proteins_masked/bonafide.f.gtf > output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf

        # Check single-exon gene proportion
        TOTAL_GENES=$(awk -F'\t' '$3=="CDS"' output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf | \
            grep -oE 'transcript_id "[^"]+"' | sort -u | wc -l)
        SINGLE_EXON=$(awk -F'\t' '$3=="CDS"' output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf | \
            grep -oE 'transcript_id "[^"]+"' | sort | uniq -c | \
            awk '$1==1 {count++} END {print count+0}')
        if [ "$TOTAL_GENES" -gt 0 ]; then
            SINGLE_PCT=$(awk "BEGIN {printf \"%.0f\", ($SINGLE_EXON/$TOTAL_GENES)*100}")
        else
            SINGLE_PCT=0
        fi
        echo "[INFO] Single-exon genes: $SINGLE_EXON / $TOTAL_GENES ($SINGLE_PCT%)"

        # Skip downsampling if the user disabled it or if >= threshold% single-exon genes
        # (high fraction indicates the organism genuinely has many intronless genes, e.g. some
        # fungi/protists; downsampling would incorrectly remove legitimate single-exon training genes)
        if [ "False" = "True" ]; then
            echo "[INFO] Downsampling disabled via skip_single_exon_downsampling — skipping"
            cp output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gtf
            echo "Skipped: skip_single_exon_downsampling=1" > output/bam_isoseq_proteins_masked/downsample_traingenes.log
        elif [ "$SINGLE_PCT" -ge 95 ]; then
            echo "[INFO] >= 95% single-exon genes detected — skipping downsampling"
            cp output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gtf
            echo "Skipped: $SINGLE_PCT% single-exon genes >= threshold 95%" > output/bam_isoseq_proteins_masked/downsample_traingenes.log
        else
            # Step 3: Downsample using Poisson distribution
            echo "[INFO] Downsampling genes with Poisson distribution (lambda=2)..."
            downsample_traingenes.pl \
                --in_gtf=output/bam_isoseq_proteins_masked/bonafide.f.clean.gtf \
                --out_gtf=output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gtf \
                --lambda=2 \
                1> output/bam_isoseq_proteins_masked/downsample_traingenes.log 2>&1
        fi

        # Step 4: Extract transcript IDs from downsampled GTF
        echo "[INFO] Extracting downsampled transcript list..."
        grep -v "^#" output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gtf | \
            awk -F'\t' '{print $9}' | \
            perl -ne 'if (/transcript_id "([^"]+)"/) {print "$1\n"}' | \
            sort -u > output/bam_isoseq_proteins_masked/downsampled_transcripts.lst

        # Step 5: Map transcript names to locus IDs from GenBank
        echo "[INFO] Mapping transcripts to locus IDs..."
        cat output/bam_isoseq_proteins_masked/bonafide.f.gb | perl -ne '
            if ($_ =~ m/LOCUS\s+(\S+)\s/) {
                $txLocus = $1;
            } elsif ($_ =~ m/\/gene=\"(\S+)\"/) {
                $txInGb3{$1} = $txLocus
            }
            if(eof()) {
                foreach (keys %txInGb3) {
                    print "$_\t$txInGb3{$_}\n";
                }
            }' > output/bam_isoseq_proteins_masked/gene_to_locus.lst

        grep -f output/bam_isoseq_proteins_masked/downsampled_transcripts.lst output/bam_isoseq_proteins_masked/gene_to_locus.lst | cut -f2 > output/bam_isoseq_proteins_masked/downsampled.loci.lst || true

        # Step 6: Filter GenBank file to keep only downsampled genes
        echo "[INFO] Filtering GenBank file with downsampled gene list..."
        filterGenesIn.pl output/bam_isoseq_proteins_masked/downsampled.loci.lst output/bam_isoseq_proteins_masked/bonafide.f.gb > output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb

        # Count genes after downsampling
        GENES_AFTER=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb || echo 0)
        GENES_REMOVED=$((GENES_BEFORE - GENES_AFTER))

        echo "[INFO] Genes before downsampling: $GENES_BEFORE"
        echo "[INFO] Genes after downsampling: $GENES_AFTER"
        echo "[INFO] Genes removed: $GENES_REMOVED"
        echo "[INFO] Retention rate: $(awk "BEGIN {printf \"%.1f\", ($GENES_AFTER/$GENES_BEFORE)*100}")%"
        echo "[INFO] ======================================="

        # Write statistics
        echo "$GENES_BEFORE -> $GENES_AFTER (removed: $GENES_REMOVED)" > output/bam_isoseq_proteins_masked/downsample_gene_count.txt

        if [ $GENES_AFTER -eq 0 ]; then
            echo "[ERROR] All genes were downsampled! Training cannot proceed."
            exit 1
        fi

        echo "[INFO] Downsampling completed successfully"
        echo "[INFO] Output: output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb"

        rm -f "output/bam_isoseq_proteins_masked/clean_genes.lst" \
              "output/bam_isoseq_proteins_masked/downsampled_transcripts.lst" \
              "output/bam_isoseq_proteins_masked/gene_to_locus.lst" \
              "output/bam_isoseq_proteins_masked/downsampled.loci.lst" 2>/dev/null || true
        
