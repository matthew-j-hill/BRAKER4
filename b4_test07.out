localrule bam2hints:
    input: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi
    output: output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff
    log: logs/bam_isoseq_proteins_masked/bam2hints/RNAseq.log
    jobid: 17
    benchmark: benchmarks/bam_isoseq_proteins_masked/bam2hints/RNAseq.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff; Input files updated by another job: output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam.csi, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam
    wildcards: sample=bam_isoseq_proteins_masked, bam_id=RNAseq
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        # Run bam2hints from AUGUSTUS
        bam2hints \
            --intronsonly \
            --in=output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam \
            --out=output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff \
            2>&1 | tee logs/bam_isoseq_proteins_masked/bam2hints/RNAseq.log

        # Check output was created
        if [ ! -s output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff ]; then
            if [ "0" = "1" ]; then
                echo "WARNING: bam2hints found no spliced reads in output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam (empty output); the RNA-Seq check of the automatic mode fallback decides how the sample continues" >> logs/bam_isoseq_proteins_masked/bam2hints/RNAseq.log
                : > output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff
            else
                echo "ERROR: bam2hints produced empty output" >> logs/bam_isoseq_proteins_masked/bam2hints/RNAseq.log
                exit 1
            fi
        fi

        n_hints=$(grep -c 'intron' output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff || echo "0")
        echo "Successfully extracted $n_hints intron hints" >> logs/bam_isoseq_proteins_masked/bam2hints/RNAseq.log

        # Record software version (bam2hints is part of AUGUSTUS)
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        SAM_VER=$(samtools --version 2>&1 | head -1 | awk '{print $2}' || true)
        ( flock 9; printf "SAMtools\t%s\n" "$SAM_VER" >> "$VERSIONS_FILE" ) 9>"$VERSIONS_FILE.lock"

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite samtools "$REPORT_DIR"
        
Activating singularity image /projects/wenglab/testtube/matthew/singularity/braker3_v3.1.3.sif

[Sat Nov 21 01:56:24 2026]
localrule run_genemark_etp_isoseq:
    input: output/bam_isoseq_proteins_masked/genome_masked.fa, ../../test_data/proteins.fa, output/bam_isoseq_proteins_masked/isoseq_sorted/isoseq.sorted.bam, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam
    output: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/hc.gff, output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/rnaseq/stringtie/transcripts_merged.gff
    log: logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
    jobid: 11
    benchmark: benchmarks/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/rnaseq/stringtie/transcripts_merged.gff, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf, output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff; Input files updated by another job: output/bam_isoseq_proteins_masked/genome_masked.fa, output/bam_isoseq_proteins_masked/isoseq_sorted/isoseq.sorted.bam, output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        # Disable set -e and pipefail: gmetp.pl, get_etp_hints.py, and
        # join_mult_hints.pl may return non-zero. See README.md Developer Notes.
        set +e
        set +o pipefail
        WORKDIR=$(pwd)
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        mkdir -p output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq

        finalDir=$(readlink -f output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq)
        rm -rf "$finalDir/failed_run_debug"
        GENOME_ABS=$(readlink -f output/bam_isoseq_proteins_masked/genome_masked.fa)
        PROTEINS_ABS=$(readlink -f ../../test_data/proteins.fa)
        LOG_ABS=$WORKDIR/logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        TRAINING_ABS=$WORKDIR/output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf
        HC_GFF_ABS=$WORKDIR/output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/hc.gff
        ETP_HINTS_ABS=$WORKDIR/output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff

        # Step 1: Copy IsoSeq BAM into etp_lr_data/
        echo "Preparing IsoSeq BAM for GeneMark-ETP (isoseq)..." > logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log

        # The gmetp.pl work dir runs on the node-local disk; only the outputs
        # are copied back to $finalDir.
        scratch_dir outDir "gmetp_isoseq_bam_isoseq_proteins_masked" "/tmp" \
            "$(( $(need_gb 1 output/bam_isoseq_proteins_masked/isoseq_sorted/isoseq.sorted.bam output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam) + $(need_gb 10 "$GENOME_ABS") + $(need_gb 5 "$PROTEINS_ABS") ))" \
            "$finalDir" 2>> "$LOG_ABS"
        # also the ProtHint shadow tree next to the scratch dir ($outDir.bin)
        trap 'rm -rf -- "$SCRATCH" ${SCRATCH:+"$SCRATCH.bin"}' EXIT
        mkdir -p "$outDir/etp_lr_data" # isoseq reads
        mkdir -p "$outDir/etp_sr_data" # short reads

        # The scratch dir is gone when the job ends: keep the logs needed to
        # debug a failed GeneMark-ETP run.
        save_debug() {
            local _dbg=(etp_config.yaml) f
            for f in $(find "$outDir" -name gms.log -not -path "*/failed_run_debug/*") "$outDir"/rnaseq/stringtie/*.gff; do
                [ -e "$f" ] && _dbg+=("${f#"$outDir"/}")
            done
            mkdir -p "$finalDir/failed_run_debug"
            copy_back "$outDir" "$finalDir/failed_run_debug" "${_dbg[@]}"
            echo "Debug files (gms.log, etp_config.yaml, StringTie GFFs) copied to $finalDir/failed_run_debug/" >> "$LOG_ABS"
        }

        BAM_IDS=""
        for bam in output/bam_isoseq_proteins_masked/isoseq_sorted/isoseq.sorted.bam; do
            BAM_ABS=$(readlink -f $bam)
            LR_LIB=$(basename $bam .sorted.bam)
            cp $BAM_ABS $outDir/etp_lr_data/${LR_LIB}.bam
            if [ -z "$BAM_IDS" ]; then
                BAM_IDS="$LR_LIB"
            else
                BAM_IDS="$BAM_IDS,$LR_LIB"
            fi
            echo "  Prepared BAM: $LR_LIB" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        done

        echo "Preparing SR BAM for GeneMark-ETP (isoseq)..." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        BAM_IDS=""
        for bam in output/bam_isoseq_proteins_masked/bam_sorted/RNAseq.sorted.bam; do
            BAM_ABS=$(readlink -f $bam)
            LIB=$(basename $bam .sorted.bam)
            cp $BAM_ABS $outDir/etp_sr_data/${LIB}.bam
            if [ -z "$BAM_IDS" ]; then
                BAM_IDS="$LIB"
            else
                BAM_IDS="$BAM_IDS,$LIB"
            fi
            echo "  Prepared BAM: $LIB" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        done

        # Step 2: Prepare protein file. The copy is as large as the protein
        # database: write it to the node-local work dir, not to the run dir;
        # protdb/ keeps it apart from the proteins_isoseq.fa/ dir gmetp.pl creates.
        mkdir -p "$outDir/protdb"
        PROT_FILE=$outDir/protdb/proteins_isoseq.fa
        sed '/^>/!s/\\.$//' $PROTEINS_ABS > $PROT_FILE

        # GeneMark-ETP only says "error in protein file parsing" on duplicated
        # IDs or unexpected characters; report the offending records (#99).
        if ! python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/check_protein_fasta.py $PROT_FILE >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log 2>&1; then
            echo "ERROR: fix the protein file ../../test_data/proteins.fa and rerun." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            exit 1
        fi

        # Step 3: Create YAML config
        cat > $outDir/etp_config.yaml << YAMLEOF
---
RepeatMasker_path: ''
annot_path: ''
genome_path: $GENOME_ABS
protdb_path: $(readlink -f $PROT_FILE)
rnaseq_sets: [$BAM_IDS]
species: bam_isoseq_proteins_masked_isoseq
translation_table: 1
gcode: 1
YAMLEOF

        echo "YAML config created with rnaseq_sets: [$BAM_IDS]" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log

        # Spaln dispatcher fix for ProtHint inside gmetp.pl (#98), see
        # run_genemark_etp.smk.
        SHADOW_DIR=$outDir.bin
        if bash /projects/wenglab/testtube/matthew/manual/braker4/scripts/make_prothint_shadow.sh $SHADOW_DIR >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log 2>&1 && [ -x $SHADOW_DIR/gmetp.pl ]; then
            GMETP=$SHADOW_DIR/gmetp.pl
            echo "[INFO] ProtHint will use the process-based Spaln dispatcher (#98)" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        else
            GMETP=gmetp.pl
            echo "[WARNING] could not install the Spaln dispatcher fix (#98), using the container's ProtHint" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
        fi

        GMES_CORES=8
        # Step 4: Run GeneMark-ETP with isoseq container
        cd $outDir

        if $GMETP \
            --cfg $outDir/etp_config.yaml \
            --workdir $outDir \
            --long_bam $outDir/etp_lr_data/${LR_LIB}.bam \
            --bam $outDir/etp_sr_data/ \
            --cores $GMES_CORES \
            --softmask \
             \
            >> $WORKDIR/logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log 2>&1
        then
            ETP_EXIT=0
        else
            ETP_EXIT=$?
        fi

        cd $WORKDIR

        if [ ! -f $outDir/genemark.gtf ]; then
            echo "ERROR: GeneMark-ETP (isoseq) failed (exit=$ETP_EXIT)" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            # Stranded reads assembled unstranded (or poor alignments) can leave
            # StringTie with single-exon transcripts only; GeneMark-ETP then
            # fails much later, in training (#67).
            TGFF=$outDir/rnaseq/stringtie/transcripts_merged.gff
            if [ -s "$TGFF" ]; then
                read -r N_TX N_MULTI < <(awk -F'\t' '$3 == "exon" && match($9, /transcript_id "[^"]+"/) { n[substr($9, RSTART, RLENGTH)]++ } END { for (t in n) { tx++; if (n[t] > 1) m++ } print tx + 0, m + 0 }' "$TGFF")
                echo "DIAGNOSTIC: StringTie assembled $N_TX transcripts, $N_MULTI of them multi-exon." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                if [ "$N_TX" -gt 0 ] && [ "$N_MULTI" -eq 0 ]; then
                    echo "HINT: StringTie assembled 0 multi-exon transcripts, so GeneMark-ETP has no spliced genes to train on." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                    echo "  Check library strandedness and the alignments: GeneMark-ETP runs StringTie without a strand option (no --rf/--fr), and BAM files of stranded reads need the XS tag (HISAT2 --rna-strandness, STAR --outSAMstrandField intronMotif)." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                    echo "  Fallback: ET mode (RNA-Seq only) or EP mode (proteins only) do not use StringTie." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                fi
            fi
            # GeneMarkS-T found no usable genes in the assembled transcripts:
            # gms2hints.pl writes an empty seed file, ProtHint stops at once and
            # gmetp.pl reports only "evidence.gff not found".
            GMST_DIR=$outDir/rnaseq/gmst
            NO_SEEDS=0
            if [ -f "$GMST_DIR/genome_gmst.gtf" ] && [ ! -s "$GMST_DIR/genome_gmst.gtf" ]; then
                NO_SEEDS=1
                N_GMST=$(awk -F'\t' '$3 == "CDS"' "$GMST_DIR/transcripts_merged.fasta.gff" 2>/dev/null | wc -l)
                echo "DIAGNOSTIC: GeneMarkS-T predicted $N_GMST genes in the assembled transcripts, but none of them maps to the genome as a usable gene (rnaseq/gmst/genome_gmst.gtf is empty)." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                if grep -q "no start sites in training" $WORKDIR/logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log "$GMST_DIR/gms.log" 2>/dev/null; then
                    echo "DIAGNOSTIC: GeneMarkS-T found no start codons to train its model on (\"no start sites in training\")." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                fi
                echo "HINT: The IsoSeq data contain too few complete transcripts of this genome's genes for GeneMark-ETP. ProtHint then gets no gene seeds, so \"evidence.gff not found\" above is a consequence, not the cause." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "  Typical reasons: few reads from this species (host tissue, a mixed sample or a related species), low coverage, or degraded RNA." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "  Fallback: EP mode (proteins only): leave the IsoSeq columns of samples.csv empty." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            fi
            if [ "$NO_SEEDS" -eq 1 ]; then
                :
            elif grep -q "Illegal division by zero" $WORKDIR/logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log 2>/dev/null; then
                N_TRAIN=$(grep "genes found for training:" $WORKDIR/logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log | tail -1 | awk '{print $NF}' 2>/dev/null || echo "unknown")
                echo "HINT: GeneMark-ETP crashed in model training (parse_set.pl / train_super.pl division by zero)." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "  Training genes found: $N_TRAIN (minimum needed: ~100 multi-exon genes)." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "  Likely causes:" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "    1. Fungal organism: set fungus = 1 in the [PARAMS] section of config.ini" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "    2. Low IsoSeq coverage: too few reads to build reliable gene models" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "    3. Protein database too distant: ProtHint yields too few HC introns" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                echo "  See https://github.com/gatech-genemark/GeneMark-ETP/issues" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            else
                TSEQ=$outDir/rnaseq/stringtie/transcripts_merged.fasta
                if [ -f "$TSEQ" ]; then
                    TSEQ_SIZE=$(wc -c < "$TSEQ")
                    echo "DIAGNOSTIC: transcripts_merged.fasta size: $TSEQ_SIZE bytes" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                    if [ "$TSEQ_SIZE" -eq 0 ]; then
                        echo "HINT: transcripts_merged.fasta is empty -- StringTie produced no transcripts from the IsoSeq BAM. Check alignment quality and coverage." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                    else
                        if [ "$ETP_EXIT" -eq 139 ]; then
                            echo "HINT: exit 139 = segmentation fault inside GeneMark-ETP." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        else
                            echo "HINT: GeneMark-ETP exited with code $ETP_EXIT without writing genemark.gtf." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        fi
                        echo "  Common causes (check these before subsampling):" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "    1. Thread count: GeneMark-ETP ran with --cores 8. Very high counts (e.g. 256) are known to crash it; lower cpus_per_task in the [SLURM_ARGS] section of config.ini." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "    2. Sequence name mismatch: @SQ names in the BAM header differ from the genome FASTA headers." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "       Check: samtools view -H <bam> | grep ^@SQ  vs  grep '>' <genome> | head" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "    3. Stranded library: GeneMark-ETP assembles transcripts unstranded, which can produce conflicting models from stranded data." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "    4. Very large transcript set: only if 1-3 are ruled out, subsample the IsoSeq BAM and rerun." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                        echo "  The failing step is usually visible in gms.log (tail printed below)." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                    fi
                else
                    echo "DIAGNOSTIC: transcripts_merged.fasta not found -- GeneMark-ETP likely crashed before StringTie completed." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                fi
            fi
            GMS_LOG=$(find $outDir -name "gms.log" | head -1)
            if [ -n "$GMS_LOG" ]; then
                echo "DIAGNOSTIC: last lines of gms.log ($GMS_LOG):" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
                tail -10 "$GMS_LOG" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            fi
            save_debug
            exit 1
        fi

        # genemark.gtf from gmetp.pl has no gene lines: count distinct gene_id
        n_genes=$(awk 'match($0, /gene_id "[^"]+"/) { id = substr($0, RSTART, RLENGTH); if (!(id in seen)) { seen[id] = 1; n++ } } END { print n + 0 }' $outDir/genemark.gtf)
        echo "GeneMark-ETP (isoseq) predicted $n_genes genes (exit=$ETP_EXIT)" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log

        # Step 5: Find and copy training genes and HC genes
        ETP_MODEL=$(find $outDir -path "*/model/training.gtf" -not -path "*/etr/*" | head -1 | xargs dirname 2>/dev/null || echo "")

        if [ -n "$ETP_MODEL" ] && [ -f "$ETP_MODEL/training.gtf" ]; then
            cp "$ETP_MODEL/training.gtf" "$TRAINING_ABS"
        else
            echo "WARNING: No model/training.gtf found, using genemark.gtf" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            cp $outDir/genemark.gtf "$TRAINING_ABS"
        fi

        if [ -n "$ETP_MODEL" ] && [ -f "$ETP_MODEL/hc.gff" ]; then
            cp "$ETP_MODEL/hc.gff" "$HC_GFF_ABS"
        else
            touch "$HC_GFF_ABS"
        fi

        # Step 6: Extract hints
        # CRITICAL: --genemark_scripts must point at /opt/ETP/bin (where
        # format_back.pl lives), NOT /opt/ETP/bin/gmes/. See
        # run_genemark_etp.smk for the full explanation. Also note that
        # get_etp_hints.py uses >> (append) for output, so the file
        # must be truncated first to make the rule re-runnable.
        # get_etp_hints.py probes for proteins.fa in --etp_wdir to detect a
        # valid GeneMark-ETP run. Our isoseq variant writes proteins_isoseq.fa,
        # so symlink the expected name. -f makes the rule re-runnable.
        ln -sf $outDir/proteins_isoseq.fa $outDir/proteins.fa
        ln -sf $outDir/rnaseq/hints/proteins_isoseq.fa $outDir/rnaseq/hints/proteins.fa
        rm -f output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff
        if get_etp_hints.py \
            --genemark_scripts /opt/ETP/bin \
            --out "$ETP_HINTS_ABS" \
            --etp_wdir $outDir \
            >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log 2>&1
        then
            HINTS_EXIT=0
        else
            HINTS_EXIT=$?
        fi

        # Hard-fail if get_etp_hints.py didn't produce a file. The manual
        # fallback that lived here historically was structurally wrong
        # (raw nonhc coordinates and only one hintsfile_merged copy
        # instead of two).
        if [ ! -s output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff ]; then
            echo "[ERROR] get_etp_hints.py failed (exit=$HINTS_EXIT) and produced no hints." >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            save_debug
            exit 1
        fi

        copy_back "$outDir" "$finalDir" genemark.gtf rnaseq/stringtie/transcripts_merged.gff
        if [ ! -s "$finalDir/genemark.gtf" ] || [ ! -f "$finalDir/rnaseq/stringtie/transcripts_merged.gff" ]; then
            echo "ERROR: genemark.gtf or rnaseq/stringtie/transcripts_merged.gff missing in $finalDir" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log
            exit 1
        fi
        # the protein copy is not needed any more (fallback; on scratch the
        # EXIT trap removes it)
        if [ -z "$SCRATCH" ]; then
            rm -f "$PROT_FILE"
        fi

        # NOTE: do NOT call join_mult_hints.pl here. See run_genemark_etp.smk
        # for the rationale. The downstream merge_hints rule does the join
        # correctly with the src=C grp= split that braker.pl requires.

        echo "GeneMark-ETP (isoseq) completed" >> logs/bam_isoseq_proteins_masked/genemark_etp_isoseq/genemark_etp_isoseq.log

        # Record software version
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        GMETP_VER=$(grep -oP 'my \$version = "\K[^"]+' $(which gmetp.pl) 2>/dev/null || true)
        GM_COMMIT=$(grep 'refs/remotes/origin/main' /opt/ETP/.git/packed-refs 2>/dev/null | awk '{print substr($1,1,7)}' || true)
        ( flock 9; printf "GeneMark-ETP (IsoSeq)\t%s (commit %s)\n" "$GMETP_VER" "$GM_COMMIT" >> "$VERSIONS_FILE" ) 9>"$VERSIONS_FILE.lock"

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh || true
        cite genemark_etp "$REPORT_DIR" || true
        cite genemarks_t "$REPORT_DIR" || true
        cite braker3 "$REPORT_DIR" || true
        cite braker_book "$REPORT_DIR" || true

        # Remove GeneMark-ETP-isoseq internal working files and etp_data/ BAM copies.
        # Tracked outputs kept: genemark.gtf, training.gtf, hc.gff,
        # rnaseq/stringtie/transcripts_merged.gff (etp_hints_isoseq.gff is outside outdir).
        if [ -z "$SCRATCH" ]; then
            find "$finalDir" -mindepth 1 -type f \
                ! -name 'genemark.gtf' \
                ! -name 'training.gtf' \
                ! -name 'hc.gff' \
                ! -path '*/rnaseq/stringtie/transcripts_merged.gff' \
                -delete 2>/dev/null || true
            find "$finalDir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
        fi
        rm -rf $SHADOW_DIR
        
