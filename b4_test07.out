localrule filter_genes_etraining:
    input: output/bam_isoseq_proteins_masked/bonafide.gb, augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/.species_created
    output: output/bam_isoseq_proteins_masked/bonafide.f.clean.gb, output/bam_isoseq_proteins_masked/etrain.bad.lst, output/bam_isoseq_proteins_masked/etraining.stdout, output/bam_isoseq_proteins_masked/etraining.stderr, output/bam_isoseq_proteins_masked/etraining_gene_count.txt
    jobid: 25
    benchmark: benchmarks/bam_isoseq_proteins_masked/filter_genes_etraining/filter_genes_etraining.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/bonafide.f.clean.gb; Input files updated by another job: augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/.species_created, output/bam_isoseq_proteins_masked/bonafide.gb
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        # Set AUGUSTUS_CONFIG_PATH to our local copy
        export AUGUSTUS_CONFIG_PATH=/projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config

        echo "[INFO] Starting etraining filtering process"
        echo "[INFO] AUGUSTUS_CONFIG_PATH: $AUGUSTUS_CONFIG_PATH"
        echo "[INFO] Species: bam_isoseq_proteins_masked"

        # Count genes before filtering
        GENES_BEFORE=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.gb || echo 0)
        echo "[INFO] ===== ETRAINING FILTERING STATISTICS ====="
        echo "[INFO] Input gene structures: $GENES_BEFORE"

        # Step 1: Run etraining to identify problematic gene structures
        # This will fail on genes with structural inconsistencies, which is expected
        echo "[INFO] Running etraining to identify problematic genes..."
        etraining --species=bam_isoseq_proteins_masked --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
            output/bam_isoseq_proteins_masked/bonafide.gb \
            1> output/bam_isoseq_proteins_masked/etraining.stdout \
            2> output/bam_isoseq_proteins_masked/etraining.stderr || true

        # Step 2: Parse stderr to extract bad gene IDs
        # Look for lines like "in sequence GENE_ID:" which indicate errors
        echo "[INFO] Extracting bad gene IDs from etraining errors..."
        grep "n sequence " output/bam_isoseq_proteins_masked/etraining.stderr | \
            sed -E 's/.*n sequence ([^:]+):.*/\1/' | \
            sort -u > output/bam_isoseq_proteins_masked/etrain.bad.lst || touch output/bam_isoseq_proteins_masked/etrain.bad.lst

        BAD_GENES=$(wc -l < output/bam_isoseq_proteins_masked/etrain.bad.lst || echo 0)
        echo "[INFO] Problematic genes found: $BAD_GENES"

        # Step 3: Filter out bad genes using filterGenes.pl
        if [ -s output/bam_isoseq_proteins_masked/etrain.bad.lst ]; then
            echo "[INFO] Filtering out problematic genes with filterGenes.pl..."
            filterGenes.pl output/bam_isoseq_proteins_masked/etrain.bad.lst output/bam_isoseq_proteins_masked/bonafide.gb > output/bam_isoseq_proteins_masked/bonafide.f.clean.gb
        else
            echo "[INFO] No problematic genes found, copying input to output"
            cp output/bam_isoseq_proteins_masked/bonafide.gb output/bam_isoseq_proteins_masked/bonafide.f.clean.gb
        fi

        # Step 4: Cap the training set to ≤ 8000 genes via randomSplit.pl
        # (matches braker.pl lines ~6358–6388). Without this cap,
        # optimize_augustus.pl can OOM on large genomes and the subsequent
        # DIAMOND self-comparison scales O(n^2).
        N_AFTER_ETRAIN=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.f.clean.gb || echo 0)
        if [ "$N_AFTER_ETRAIN" -gt 8000 ]; then
            echo "[INFO] Training set has $N_AFTER_ETRAIN genes (> 8000); capping to 8000 via randomSplit.pl"
            # randomSplit.pl writes <input>.test (the 8000 sub-sample) and
            # <input>.train (the remainder). We keep .test, drop .train, and
            # move .test back to the canonical output path.
            randomSplit.pl output/bam_isoseq_proteins_masked/bonafide.f.clean.gb 8000
            mv output/bam_isoseq_proteins_masked/bonafide.f.clean.gb.test output/bam_isoseq_proteins_masked/bonafide.f.clean.gb
            rm -f output/bam_isoseq_proteins_masked/bonafide.f.clean.gb.train
        else
            echo "[INFO] Training set has $N_AFTER_ETRAIN genes (≤ 8000); no cap applied"
        fi

        # Step 5: Count genes after filtering AND cap
        GENES_AFTER=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.f.clean.gb || echo 0)
        GENES_RETAINED=$GENES_AFTER

        echo "[INFO] Genes removed by etraining: $BAD_GENES"
        echo "[INFO] Genes retained for training: $GENES_RETAINED"
        echo "[INFO] Retention rate: $(awk "BEGIN {printf \"%.1f\", ($GENES_RETAINED/$GENES_BEFORE)*100}")%"
        echo "[INFO] =========================================="

        # Write gene count statistics
        echo "$GENES_BEFORE -> $GENES_AFTER (removed: $BAD_GENES, retained: $GENES_RETAINED)" > output/bam_isoseq_proteins_masked/etraining_gene_count.txt

        if [ $GENES_AFTER -eq 0 ]; then
            echo "[ERROR] All genes were filtered out! Training cannot proceed."
            exit 1
        fi

        echo "[INFO] etraining filtering completed successfully"
        echo "[INFO] Clean training set written to: output/bam_isoseq_proteins_masked/bonafide.f.clean.gb"
        
