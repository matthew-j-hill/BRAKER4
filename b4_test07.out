        # samtools sort chunks in a private dir: in the fallback (no scratch)
        # all jobs share outDir, and a fixed prefix made parallel jobs and
        # retries collide on sort.NNNN.bam ('File exists')
        SORT_TMP=$(mktemp -d "$outDir/.samtools_sort_XXXXXX")
        trap 'rm -rf -- "$SCRATCH" "$SORT_TMP"' EXIT
        SORTED_BAM="$outDir/isoseq.sorted.bam"

        samtools sort -@ 8 -T "$SORT_TMP/sort" -o "$SORTED_BAM" "$BAM_ABS" 2>> logs/bam_isoseq_proteins_masked/check_isoseq_bam/isoseq.log
        echo "Sorting complete" >> logs/bam_isoseq_proteins_masked/check_isoseq_bam/isoseq.log

        samtools index -c -@ 8 "$SORTED_BAM" 2>> logs/bam_isoseq_proteins_masked/check_isoseq_bam/isoseq.log
        echo "Indexing complete" >> logs/bam_isoseq_proteins_masked/check_isoseq_bam/isoseq.log
        if [ -n "$SCRATCH" ]; then
            cp "$SORTED_BAM" "$OUT_BAM_ABS.tmp"
            mv "$OUT_BAM_ABS.tmp" "$OUT_BAM_ABS"
            cp "$SORTED_BAM.csi" "$OUT_CSI_ABS.tmp"
            mv "$OUT_CSI_ABS.tmp" "$OUT_CSI_ABS"
        fi
        if [ ! -s "$OUT_BAM_ABS" ] || [ ! -s "$OUT_CSI_ABS" ]; then
            echo "ERROR: output/bam_isoseq_proteins_masked/isoseq_sorted/isoseq.sorted.bam or its .csi missing after the copy back" >> logs/bam_isoseq_proteins_masked/check_isoseq_bam/isoseq.log
            exit 1
        fi
        
