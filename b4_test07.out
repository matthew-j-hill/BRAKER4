localrule split_training_set:
    input: output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb
    output: output/bam_isoseq_proteins_masked/train.gb.test, output/bam_isoseq_proteins_masked/train.gb.train, output/bam_isoseq_proteins_masked/training_set_split.log
    jobid: 22
    benchmark: benchmarks/bam_isoseq_proteins_masked/split_training_set/split_training_set.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/train.gb.train, output/bam_isoseq_proteins_masked/training_set_split.log, output/bam_isoseq_proteins_masked/train.gb.test; Input files updated by another job: output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        echo "[INFO] ========== TRAINING SET SPLIT ==========" | tee output/bam_isoseq_proteins_masked/training_set_split.log

        # Count total genes in input
        TOTAL_GENES=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb || echo 0)
        echo "[INFO] Total genes in clean training set: $TOTAL_GENES" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log

        # Determine test set size based on BRAKER logic
        if [ $TOTAL_GENES -lt 600 ]; then
            # For small datasets, use 1/3 of genes for test set
            TESTSIZE=$(($TOTAL_GENES / 3))

            # Check if we have enough genes (need at least 2 genes for train and test)
            REMAINING=$(($TOTAL_GENES - $TESTSIZE))
            if [ $TESTSIZE -eq 0 ] || [ $REMAINING -eq 0 ]; then
                echo "[ERROR] Insufficient training genes ($TOTAL_GENES) for train/test split!" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
                echo "[ERROR] Need at least 2 genes for train/test split" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
                exit 1
            fi
        elif [ $TOTAL_GENES -le 1000 ]; then
            TESTSIZE=200
        else
            TESTSIZE=300
        fi

        echo "[INFO] Test set size: $TESTSIZE genes" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        echo "[INFO] Training set size: $(($TOTAL_GENES - $TESTSIZE)) genes" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log

        # Perform the split using randomSplit.pl
        echo "[INFO] Splitting training set..." | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        randomSplit.pl output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb $TESTSIZE 2>&1 | tee -a output/bam_isoseq_proteins_masked/training_set_split.log

        # Move the split files to their final locations
        mv output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb.test output/bam_isoseq_proteins_masked/train.gb.test
        mv output/bam_isoseq_proteins_masked/bonafide.f.clean.d.gb.train output/bam_isoseq_proteins_masked/train.gb.train

        # Count genes in each split
        GENES_TEST=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.test || echo 0)
        GENES_TRAIN=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.train || echo 0)

        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        echo "[INFO] Split complete:" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        echo "[INFO]   Test set: $GENES_TEST genes (held out for accuracy measurement)" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        echo "[INFO]   Training set: $GENES_TRAIN genes (will be used for etraining)" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log
        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/training_set_split.log

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        
