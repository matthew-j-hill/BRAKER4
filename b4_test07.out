localrule busco_proteins:
    input: output/bam_isoseq_proteins_masked/braker.longest.aa
    output: output/bam_isoseq_proteins_masked/busco/proteins/.done
    log: logs/bam_isoseq_proteins_masked/busco/busco_proteins.log
    jobid: 41
    benchmark: benchmarks/bam_isoseq_proteins_masked/busco/busco_proteins.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/busco/proteins/.done; Input files updated by another job: output/bam_isoseq_proteins_masked/braker.longest.aa
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        set -euo pipefail
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        OUTDIR_ABS=$(readlink -f output/bam_isoseq_proteins_masked/busco)
        rm -rf "$OUTDIR_ABS/proteins"
        finalDir=$OUTDIR_ABS

        scratch_dir outDir "busco_proteins_bam_isoseq_proteins_masked" "/tmp" 10 "$finalDir" 2>> logs/bam_isoseq_proteins_masked/busco/busco_proteins.log
        trap 'rm -rf -- "$SCRATCH"' EXIT

        mkdir -p /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads
        OFFLINE_FLAG=""
        # Check for dataset.cfg, not just the directory: compleasm and BUSCO
        # share the same /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/ default, but
        # `compleasm.py download` writes a compleasm-only layout (no
        # dataset.cfg). Only switch to --offline when the directory is a
        # valid BUSCO lineage.
        if [ -f "/projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/eukaryota_odb12/dataset.cfg" ]; then
            OFFLINE_FLAG="--offline"
            echo "[INFO] Found pre-downloaded lineage at /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/eukaryota_odb12; running BUSCO with --offline" >> logs/bam_isoseq_proteins_masked/busco/busco_proteins.log
        fi

        # hmmsearch aborts on targets >= 100,000 aa ("over comparison pipeline
        # limit"), which kills the whole BUSCO run (issues #91, #92). No real
        # protein is that long, so hand BUSCO a copy without such sequences.
        BUSCO_INPUT="$outDir/busco_input_proteins.faa"
        awk -v max=100000 -v skipped="$outDir/busco_skipped_long_proteins.txt" '
            function flush() {
                if (hdr == "") return
                s = seq; sub(/\*$/, "", s)
                if (length(s) >= max) { split(substr(hdr, 2), a, /[ \t]/); print a[1] > skipped; n++ }
                else print hdr "\n" seq
            }
            /^>/ { flush(); hdr = $0; seq = ""; next }
            { gsub(/[ \t\r]/, ""); seq = seq $0 }
            END { flush(); if (n > 0) printf "[WARNING] Skipped %d protein(s) >= %d aa for BUSCO (hmmsearch limit)\n", n, max > "/dev/stderr" }
        ' output/bam_isoseq_proteins_masked/braker.longest.aa > "$BUSCO_INPUT" 2>> logs/bam_isoseq_proteins_masked/busco/busco_proteins.log

        busco \
            -i "$BUSCO_INPUT" \
            -o proteins \
            --out_path "$outDir" \
            -l eukaryota_odb12 \
            -m proteins \
            -c 8 \
            --download_path /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads \
            $OFFLINE_FLAG \
            >> logs/bam_isoseq_proteins_masked/busco/busco_proteins.log 2>&1
        rm -f "$BUSCO_INPUT"

        # Keep only short_summary*.txt (see busco_genome) and the list of
        # proteins skipped for length.
        mapfile -t _keep < <(cd "$outDir" && find proteins -name 'short_summary*.txt')
        _keep+=(busco_skipped_long_proteins.txt)
        # copy_back without names copies everything: only call it with names
        if [ ${#_keep[@]} -gt 0 ]; then
            copy_back "$outDir" "$finalDir" "${_keep[@]}"
        fi
        if ! find "$finalDir/proteins" -name 'short_summary*.txt' 2>/dev/null | grep -q .; then
            echo "ERROR: no BUSCO short_summary*.txt in $finalDir/proteins" >> logs/bam_isoseq_proteins_masked/busco/busco_proteins.log
            exit 1
        fi
        if [ -z "$SCRATCH" ]; then
            find "$OUTDIR_ABS/proteins" -mindepth 1 \( -type f -o -type l \) \
                ! -name 'short_summary*.txt' ! -name '.done' \
                -delete 2>/dev/null || true
            find "$OUTDIR_ABS/proteins" -mindepth 1 -type d -empty \
                -delete 2>/dev/null || true
        fi

        touch output/bam_isoseq_proteins_masked/busco/proteins/.done

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        PROT_SUMMARY=$(find "$OUTDIR_ABS/proteins" -name "short_summary*.txt" 2>/dev/null | head -1)
        BUSCO_LINE=""
        if [ -n "$PROT_SUMMARY" ] && [ -f "$PROT_SUMMARY" ]; then
            BUSCO_LINE=$(grep -oE 'C:[0-9.]+%.*' "$PROT_SUMMARY" | head -1)
        fi
        cite busco "$REPORT_DIR"
        
