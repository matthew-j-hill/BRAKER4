localrule convert_to_genbank:
    input: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/flanking_dna_value.txt, output/bam_isoseq_proteins_masked/genome.fa
    output: output/bam_isoseq_proteins_masked/bonafide.gb
    jobid: 26
    benchmark: benchmarks/bam_isoseq_proteins_masked/convert_to_genbank/convert_to_genbank.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/bonafide.gb; Input files updated by another job: output/bam_isoseq_proteins_masked/flanking_dna_value.txt, output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        # Read the flanking DNA value from the file
        FLANKING=$(cat output/bam_isoseq_proteins_masked/flanking_dna_value.txt)
        echo "[INFO] Using flanking DNA value: $FLANKING"

        # Create output directory if it doesn't exist
        mkdir -p $(dirname output/bam_isoseq_proteins_masked/bonafide.gb)

        # Step 1 — gff2gbSmallDNA.pl on the FULL GeneMark output (trainGb1)
        TRAINGB1=output/bam_isoseq_proteins_masked/bonafide.gb.full
        gff2gbSmallDNA.pl output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf output/bam_isoseq_proteins_masked/genome.fa $FLANKING $TRAINGB1
        N_GB1=$(grep -c '^LOCUS' $TRAINGB1 || echo 0)
        echo "[INFO] Step 1: gff2gbSmallDNA.pl produced $N_GB1 GenBank entries"

        # Step 2 — filter to hint-supported transcripts (trainGb2)
        # When the full and filtered GTFs are identical (ETP/IsoSeq/dual or ES),
        # this is a no-op in terms of selected genes.
        filterGenesIn_mRNAname.pl output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf $TRAINGB1 > output/bam_isoseq_proteins_masked/bonafide.gb
        N_GB2=$(grep -c '^LOCUS' output/bam_isoseq_proteins_masked/bonafide.gb || echo 0)
        echo "[INFO] Step 2: filterGenesIn_mRNAname.pl retained $N_GB2 hint-supported entries"

        # Drop the intermediate full set; downstream rules consume output/bam_isoseq_proteins_masked/bonafide.gb only
        rm -f $TRAINGB1

        if [ $N_GB2 -eq 0 ]; then
            echo "[ERROR] No genes survived hint-based filtering. Check that"
            echo "        output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf contains transcript_ids matching"
            echo "        the entries in the GenBank file built from output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf."
            exit 1
        fi

        echo "[INFO] GTF to GenBank conversion completed"
        echo "[INFO] Output written to output/bam_isoseq_proteins_masked/bonafide.gb"
        
