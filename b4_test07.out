        set -euo pipefail

        # Set AUGUSTUS_CONFIG_PATH
        export AUGUSTUS_CONFIG_PATH=/projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config

        echo "[INFO] ========== AUGUSTUS PARAMETER OPTIMIZATION ==========" | tee output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] AUGUSTUS_CONFIG_PATH: $AUGUSTUS_CONFIG_PATH" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Species: bam_isoseq_proteins_masked" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Skip optimization: True" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Training set: output/bam_isoseq_proteins_masked/train.gb.train" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Test set: output/bam_isoseq_proteins_masked/train.gb.test" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Use /dev/shm: False" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Temporary storage for optimize_augustus buckets: node-local scratch
        # (/dev/shm with use_dev_shm), removed on exit; output/<sample> when
        # short of space.
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        scratch_dir outDir "optaug_bam_isoseq_proteins_masked" "/tmp" 20 \
            "$PWD/output/bam_isoseq_proteins_masked" 2>> output/bam_isoseq_proteins_masked/optimize_augustus.log
        trap 'rm -rf -- "$SCRATCH"' EXIT
        OPTIMIZE_TMP=$outDir

        # Count genes in training and test sets (already split by split_training_set rule)
        GENES_TEST=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.test || echo 0)
        GENES_TRAIN=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.train || echo 0)
        echo "[INFO] Test set genes: $GENES_TEST (held out for final accuracy)" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Training set genes: $GENES_TRAIN (will be further split for optimization)" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Determine test set size for optimization split based on BRAKER logic
        if [ $GENES_TRAIN -lt 600 ]; then
            # For small datasets, use 1/3 of training genes for optimization test
            TESTSIZE2=$(($GENES_TRAIN / 3))

            # Check if we have enough genes
            REMAINING=$(($GENES_TRAIN - $TESTSIZE2))
            if [ $TESTSIZE2 -eq 0 ] || [ $REMAINING -eq 0 ]; then
                echo "[ERROR] Insufficient training genes ($GENES_TRAIN) for optimization split!" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
                echo "[ERROR] Need at least 2 genes for optimization train/test split" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
                exit 1
            fi
        elif [ $GENES_TRAIN -le 1000 ]; then
            TESTSIZE2=200
        else
            TESTSIZE2=300
        fi

        echo "[INFO] Optimization test set size: $TESTSIZE2 genes" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Split training set for optimization
        echo "[INFO] Creating train/test split for parameter optimization..." | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        randomSplit.pl output/bam_isoseq_proteins_masked/train.gb.train $TESTSIZE2 2>&1 | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        # randomSplit.pl creates output/bam_isoseq_proteins_masked/train.gb.train.test and output/bam_isoseq_proteins_masked/train.gb.train.train
        # which are train.gb.train.test and train.gb.train.train

        GENES_TRAIN_TRAIN=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.train.train || echo 0)
        GENES_TRAIN_TEST=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.train.test || echo 0)
        echo "[INFO] Optimization training set: $GENES_TRAIN_TRAIN genes" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Optimization test set: $GENES_TRAIN_TEST genes" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Step 2b: Run AUGUSTUS on test set to assess accuracy after initial training
        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Assessing AUGUSTUS accuracy after initial training (before optimization)..." | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        augustus \
            --species=bam_isoseq_proteins_masked \
            --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
            output/bam_isoseq_proteins_masked/train.gb.test \
            > output/bam_isoseq_proteins_masked/augustus_test_after_training.out 2>&1

        # Parse accuracy from AUGUSTUS output (values are fractions, need to multiply by 100 for percentages)
        NU_SEN=$(grep "^nucleotide level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $4 * 100}')
        NU_SP=$(grep "^nucleotide level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $6 * 100}')
        EX_SEN=$(grep "^exon level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $14 * 100}')
        EX_SP=$(grep "^exon level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $16 * 100}')
        GEN_SEN=$(grep "^gene level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $14 * 100}')
        GEN_SP=$(grep "^gene level" output/bam_isoseq_proteins_masked/augustus_test_after_training.out | awk '{printf "%.2f", $16 * 100}')

        # Calculate target accuracy (BRAKER formula: weighted average)
        # target = (3*nu_sen + 2*nu_sp + 4*ex_sen + 3*ex_sp + 2*gen_sen + 1*gen_sp) / 15
        ACCURACY_AFTER_TRAINING=$(awk "BEGIN {printf \"%.2f\", (3*$NU_SEN + 2*$NU_SP + 4*$EX_SEN + 3*$EX_SP + 2*$GEN_SEN + 1*$GEN_SP) / 15}")

        echo "[INFO] Accuracy after initial training: $ACCURACY_AFTER_TRAINING%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO]   Nucleotide level - Sensitivity: $NU_SEN%, Specificity: $NU_SP%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO]   Exon level - Sensitivity: $EX_SEN%, Specificity: $EX_SP%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO]   Gene level - Sensitivity: $GEN_SEN%, Specificity: $GEN_SP%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Save accuracy to file
        cat > output/bam_isoseq_proteins_masked/accuracy_after_training.txt <<ACCURACY1
AUGUSTUS Accuracy After Initial Training (before optimize_augustus.pl)

Nucleotide level:
  Sensitivity: $NU_SEN%
  Specificity: $NU_SP%

Exon level:
  Sensitivity: $EX_SEN%
  Specificity: $EX_SP%

Gene level:
  Sensitivity: $GEN_SEN%
  Specificity: $GEN_SP%

Target accuracy (weighted): $ACCURACY_AFTER_TRAINING%
Formula: (3*nu_sen + 2*nu_sp + 4*ex_sen + 3*ex_sp + 2*gen_sen + 1*gen_sp) / 15
ACCURACY1

        # Step 3: Run optimize_augustus.pl (unless skipped)
        if [ "True" = "True" ]; then
            echo "[INFO] Skipping optimize_augustus.pl (skip_optimize_augustus=1)" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO] This will save runtime but may reduce accuracy by 2-3%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Create empty accuracy file indicating optimization was skipped
            cat > output/bam_isoseq_proteins_masked/accuracy_after_optimize.txt <<ACCURACY_SKIP
AUGUSTUS Accuracy After Optimization

NOTE: optimize_augustus.pl was SKIPPED (skip_optimize_augustus=1)
No optimization was performed, so there is no post-optimization accuracy to report.

The parameters from the initial etraining are being used without further optimization.
See accuracy_after_training.txt for the accuracy after initial training.
ACCURACY_SKIP
        else
            # Calculate k-fold: each bucket needs >= 200 genes for robust optimization.
            # Start at 8 (BRAKER default), scale up with CPUs if enough genes,
            # but scale DOWN if too few genes. Minimum 2-fold (below that, skip).
            K_FOLD=8
            if [ $GENES_TRAIN_TRAIN -lt 400 ]; then
                # Too few genes for meaningful optimization
                echo "[WARNING] Only $GENES_TRAIN_TRAIN training genes — too few for robust k-fold optimization" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
                K_FOLD=2
            else
                # Find largest k where each bucket has >= 200 genes, up to #CPUs
                K_FOLD=2
                MAX_K=8
                if [ $MAX_K -lt 8 ]; then MAX_K=8; fi
                for ((i=2; i<=MAX_K; i++)); do
                    if [ $(($GENES_TRAIN_TRAIN / $i)) -ge 200 ]; then
                        K_FOLD=$i
                    fi
                done
            fi

            echo "[INFO] Using $K_FOLD-fold cross-validation with 8 CPUs" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO] Running optimize_augustus.pl (rounds=5)..." | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO] Working directory for buckets: $OPTIMIZE_TMP" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Convert paths to absolute before changing directory
            TRAIN_TRAIN_ABS=$(readlink -f output/bam_isoseq_proteins_masked/train.gb.train.train)
            TRAIN_TEST_ABS=$(readlink -f output/bam_isoseq_proteins_masked/train.gb.train.test)
            LOG_ABS=$(readlink -f output/bam_isoseq_proteins_masked/optimize_augustus.log)

            # Change to temporary directory so optimize_augustus.pl creates buckets there
            cd "$OPTIMIZE_TMP"

            # Run optimize_augustus.pl (redirect output to log)
            # Note: optimize_augustus.pl creates bucket directories in current working directory
            optimize_augustus.pl \
                --species=bam_isoseq_proteins_masked \
                --rounds=5 \
                --kfold=$K_FOLD \
                --cpus=$K_FOLD \
                --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
                --onlytrain=$TRAIN_TRAIN_ABS \
                $TRAIN_TEST_ABS \
                >> $LOG_ABS 2>&1

            # Return to original directory
            cd -

            echo "[INFO] Parameter optimization completed" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Step 4: Run final etraining on full training set with optimized parameters
            echo "[INFO] Running final etraining on full training set..." | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            etraining \
                --species=bam_isoseq_proteins_masked \
                --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
                output/bam_isoseq_proteins_masked/train.gb.train \
                >> output/bam_isoseq_proteins_masked/optimize_augustus.log 2>&1

            echo "[INFO] Final etraining completed" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Step 5: Run AUGUSTUS on test set to assess accuracy after optimization
            echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO] Assessing AUGUSTUS accuracy after optimization and final etraining..." | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            augustus \
                --species=bam_isoseq_proteins_masked \
                --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
                output/bam_isoseq_proteins_masked/train.gb.test \
                > output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out 2>&1

            # Parse accuracy from AUGUSTUS output (values are fractions, need to multiply by 100 for percentages)
            NU_SEN_OPT=$(grep "^nucleotide level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $4 * 100}')
            NU_SP_OPT=$(grep "^nucleotide level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $6 * 100}')
            EX_SEN_OPT=$(grep "^exon level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $14 * 100}')
            EX_SP_OPT=$(grep "^exon level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $16 * 100}')
            GEN_SEN_OPT=$(grep "^gene level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $14 * 100}')
            GEN_SP_OPT=$(grep "^gene level" output/bam_isoseq_proteins_masked/augustus_test_after_optimize.out | awk '{printf "%.2f", $16 * 100}')

            # Calculate target accuracy (BRAKER formula: weighted average)
            ACCURACY_AFTER_OPTIMIZE=$(awk "BEGIN {printf \"%.2f\", (3*$NU_SEN_OPT + 2*$NU_SP_OPT + 4*$EX_SEN_OPT + 3*$EX_SP_OPT + 2*$GEN_SEN_OPT + 1*$GEN_SP_OPT) / 15}")

            echo "[INFO] Accuracy after optimization: $ACCURACY_AFTER_OPTIMIZE%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO]   Nucleotide level - Sensitivity: $NU_SEN_OPT%, Specificity: $NU_SP_OPT%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO]   Exon level - Sensitivity: $EX_SEN_OPT%, Specificity: $EX_SP_OPT%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
            echo "[INFO]   Gene level - Sensitivity: $GEN_SEN_OPT%, Specificity: $GEN_SP_OPT%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Calculate improvement
            IMPROVEMENT=$(awk "BEGIN {printf \"%.2f\", $ACCURACY_AFTER_OPTIMIZE - $ACCURACY_AFTER_TRAINING}")
            echo "[INFO] Improvement from optimization: $IMPROVEMENT%" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

            # Save accuracy to file
            cat > output/bam_isoseq_proteins_masked/accuracy_after_optimize.txt <<ACCURACY2
AUGUSTUS Accuracy After Optimization (after optimize_augustus.pl and final etraining)

Nucleotide level:
  Sensitivity: $NU_SEN_OPT%
  Specificity: $NU_SP_OPT%

Exon level:
  Sensitivity: $EX_SEN_OPT%
  Specificity: $EX_SP_OPT%

Gene level:
  Sensitivity: $GEN_SEN_OPT%
  Specificity: $GEN_SP_OPT%

Target accuracy (weighted): $ACCURACY_AFTER_OPTIMIZE%
Formula: (3*nu_sen + 2*nu_sp + 4*ex_sen + 3*ex_sp + 2*gen_sen + 1*gen_sp) / 15

Improvement from initial training: $IMPROVEMENT%
ACCURACY2
        fi

        # Summary
        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] AUGUSTUS optimization complete" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Final training set: output/bam_isoseq_proteins_masked/train.gb.train ($GENES_TRAIN genes)" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Final test set: output/bam_isoseq_proteins_masked/train.gb.test ($GENES_TEST genes)" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log
        echo "[INFO] Optimized parameters in: $AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked/" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Create training gene summary file for easy reference
        cat > output/bam_isoseq_proteins_masked/training_gene_summary.txt <<SUMMARY
=== AUGUSTUS Training Gene Summary ===

Test set (held out): $GENES_TEST genes
Training set (used for etraining): $GENES_TRAIN genes

Training split for optimize_augustus.pl:
  Optimization training set: $GENES_TRAIN_TRAIN genes
  Optimization test set: $GENES_TRAIN_TEST genes

Final etraining used: $GENES_TRAIN genes (from output/bam_isoseq_proteins_masked/train.gb.train)

Note: The final etraining run (after optimize_augustus.pl) uses the full
training set (output/bam_isoseq_proteins_masked/train.gb.train) with optimized parameters.
The test set (output/bam_isoseq_proteins_masked/train.gb.test) is NEVER used for training, only for accuracy measurement.
SUMMARY

        echo "[INFO] Training gene summary written to output/bam_isoseq_proteins_masked/training_gene_summary.txt" | tee -a output/bam_isoseq_proteins_masked/optimize_augustus.log

        # Remove optimize_augustus.pl bucket and tmp_opt_<species> dirs
        # (fallback only). On scratch the EXIT trap removes $OPTIMIZE_TMP.
        if [ -z "$SCRATCH" ]; then
            rm -rf "$OPTIMIZE_TMP"/bucket_* "$OPTIMIZE_TMP"/tmp_opt_* 2>/dev/null || true
        fi

        # Citations
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite augustus "$REPORT_DIR"
        
