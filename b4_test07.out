localrule join_hints:
    input: output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff
    output: output/bam_isoseq_proteins_masked/bam2hints.raw.gff
    log: logs/bam_isoseq_proteins_masked/join_hints/join_hints.log
    jobid: 16
    benchmark: benchmarks/bam_isoseq_proteins_masked/join_hints/join_hints.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/bam2hints.raw.gff; Input files updated by another job: output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        # Concatenate all individual hint files
        cat output/bam_isoseq_proteins_masked/hints/individual/RNAseq.hints.gff > output/bam_isoseq_proteins_masked/hints/hintsfile.temp.gff

        # Separate hints: src=C with grp tags should not be merged
        grep 'src=C' output/bam_isoseq_proteins_masked/hints/hintsfile.temp.gff | \
            grep -E 'grp=|group=' > output/bam_isoseq_proteins_masked/hints/no_merge.gff || true

        # Everything else can be merged
        grep -v 'src=C' output/bam_isoseq_proteins_masked/hints/hintsfile.temp.gff > output/bam_isoseq_proteins_masked/hints/to_merge.gff || true
        grep 'src=C' output/bam_isoseq_proteins_masked/hints/hintsfile.temp.gff | \
            grep -vE 'grp=|group=' >> output/bam_isoseq_proteins_masked/hints/to_merge.gff || true

        # Sort hints for join_mult_hints.pl
        # Sort by: scaffold, type, start, end
        if [ -s output/bam_isoseq_proteins_masked/hints/to_merge.gff ]; then
            cat output/bam_isoseq_proteins_masked/hints/to_merge.gff | \
                sort -k1,1 -k3,3 -k4,4n -k5,5n \
                > output/bam_isoseq_proteins_masked/hints/sorted.gff

            # Join identical hints into multiplicity hints
            join_mult_hints.pl \
                < output/bam_isoseq_proteins_masked/hints/sorted.gff \
                > output/bam_isoseq_proteins_masked/hints/joined.gff \
                2>> logs/bam_isoseq_proteins_masked/join_hints/join_hints.log

            # Combine joined hints with non-merged hints
            cat output/bam_isoseq_proteins_masked/hints/joined.gff \
                output/bam_isoseq_proteins_masked/hints/no_merge.gff \
                > output/bam_isoseq_proteins_masked/bam2hints.raw.gff
        else
            # If nothing to merge, just use non-merged hints
            cp output/bam_isoseq_proteins_masked/hints/no_merge.gff output/bam_isoseq_proteins_masked/bam2hints.raw.gff
        fi

        # Cleanup temp files
        rm -f output/bam_isoseq_proteins_masked/hints/hintsfile.temp.gff \
              output/bam_isoseq_proteins_masked/hints/to_merge.gff \
              output/bam_isoseq_proteins_masked/hints/no_merge.gff \
              output/bam_isoseq_proteins_masked/hints/sorted.gff \
              output/bam_isoseq_proteins_masked/hints/joined.gff

        echo "Final hints file contains $(wc -l < output/bam_isoseq_proteins_masked/bam2hints.raw.gff) hints" >> logs/bam_isoseq_proteins_masked/join_hints/join_hints.log

        # Remove HISAT2 index files; all alignments are done at this point
        # (join_hints depends on every bam2hints output which depends on every BAM).
        # Also remove the sentinel so a pipeline restart would rebuild the index
        # rather than try to align against missing .ht2 files.
        rm -f output/bam_isoseq_proteins_masked/hisat2/genome.*.ht2 \
              output/bam_isoseq_proteins_masked/hisat2/genome.*.ht2l \
              output/bam_isoseq_proteins_masked/hisat2/.index_complete 2>/dev/null || true
        
