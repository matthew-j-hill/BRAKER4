localrule prepare_genome:
    input: ../../test_data/genome.fa
    output: output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/genome.fa.fai, output/bam_isoseq_proteins_masked/preprocessing/.headers_fixed
    jobid: 13
    benchmark: benchmarks/bam_isoseq_proteins_masked/prepare_genome/prepare_genome.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/genome.fa.fai, output/bam_isoseq_proteins_masked/preprocessing/.headers_fixed
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail
        mkdir -p output/bam_isoseq_proteins_masked/preprocessing

        # Drop leading ';' comment lines (FHR metadata, BRAKER#982) and
        # clean FASTA headers: keep only first word (accession)
        N_COMMENT=$(awk '/^>/ {exit} /^[[:space:]]*;/ {n++} END {print n+0}' ../../test_data/genome.fa)
        if [ "$N_COMMENT" -gt 0 ]; then
            echo "[INFO] Dropped $N_COMMENT leading ';' comment line(s) from genome FASTA (e.g. FAIR-bioHeaders metadata)"
        fi
        awk '!seen && /^[[:space:]]*(;|$)/ {next} {seen=1; if (/^>/) sub(/ .*/, ""); print}' \
            ../../test_data/genome.fa > output/bam_isoseq_proteins_masked/genome.fa
        # Duplicated sequence names pass samtools faidx with only a warning
        # and fail hours later (randomSplit.pl: "LOCUS names in genbank file
        # are not unique", Gaius-Augustus/BRAKER#977). Stop here instead.
        DUPS=$(awk '/^>/ { n = substr($1, 2); if (c[n]++ == 1 && k++ < 5) printf "%s ", n }' output/bam_isoseq_proteins_masked/genome.fa)
        if [ -n "$DUPS" ]; then
            echo "ERROR: sequence names occur more than once in the genome FASTA (after cutting headers at the first space), e.g.: $DUPS" >&2
            echo "  Rename or remove the duplicated sequences and start again." >&2
            exit 1
        fi
        samtools faidx output/bam_isoseq_proteins_masked/genome.fa

        # Check if headers were actually modified
        if diff -q <(grep '^>' ../../test_data/genome.fa) <(grep '^>' output/bam_isoseq_proteins_masked/genome.fa) > /dev/null 2>&1; then
            echo "no" > output/bam_isoseq_proteins_masked/preprocessing/.headers_fixed
        else
            echo "yes" > output/bam_isoseq_proteins_masked/preprocessing/.headers_fixed
            echo "[INFO] Cleaned FASTA headers in genome (stripped descriptions)"
        fi

        # Record pipeline and Snakemake versions (runs on host, no container)
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        mkdir -p $(dirname $VERSIONS_FILE)
        SM_VER=$(snakemake --version 2>/dev/null || python3 -c "import snakemake; print(snakemake.__version__)" 2>/dev/null || echo "unknown")
        ( flock 9
          printf "BRAKER4 pipeline\t%s\n" "0.8.0-beta" >> "$VERSIONS_FILE"
          printf "Snakemake\t%s\n" "$SM_VER" >> "$VERSIONS_FILE"
        ) 9>"$VERSIONS_FILE.lock"

        # Cite pipeline and workflow manager
        REPORT_DIR=output/bam_isoseq_proteins_masked
        mkdir -p $REPORT_DIR
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite braker4 "$REPORT_DIR"
        cite snakemake "$REPORT_DIR"
        
