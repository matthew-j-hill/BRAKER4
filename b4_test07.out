localrule prepare_masked_genome:
    input: ../../test_data/genome.fa
    output: output/bam_isoseq_proteins_masked/genome_masked.fa
    jobid: 9
    benchmark: benchmarks/bam_isoseq_proteins_masked/prepare_masked_genome/prepare_masked_genome.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/genome_masked.fa
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail
        # Drop leading ';' comment lines and clean FASTA headers
        # (same as prepare_genome, BRAKER#982)
        awk '!seen && /^[[:space:]]*(;|$)/ {next} {seen=1; if (/^>/) sub(/ .*/, ""); print}' \
            ../../test_data/genome.fa > output/bam_isoseq_proteins_masked/genome_masked.fa
        # Duplicated sequence names pass samtools faidx with only a warning
        # and fail hours later (randomSplit.pl: "LOCUS names in genbank file
        # are not unique", Gaius-Augustus/BRAKER#977). Stop here instead.
        DUPS=$(awk '/^>/ { n = substr($1, 2); if (c[n]++ == 1 && k++ < 5) printf "%s ", n }' output/bam_isoseq_proteins_masked/genome_masked.fa)
        if [ -n "$DUPS" ]; then
            echo "ERROR: sequence names occur more than once in the genome FASTA (after cutting headers at the first space), e.g.: $DUPS" >&2
            echo "  Rename or remove the duplicated sequences and start again." >&2
            exit 1
        fi
        
