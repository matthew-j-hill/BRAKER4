localrule run_compleasm:
    input: output/bam_isoseq_proteins_masked/genome.fa
    output: output/bam_isoseq_proteins_masked/compleasm_hints.gff, output/bam_isoseq_proteins_masked/compleasm_to_hints.log, output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt
    log: logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
    jobid: 20
    benchmark: benchmarks/bam_isoseq_proteins_masked/run_compleasm/run_compleasm.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/compleasm_hints.gff, output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt; Input files updated by another job: output/bam_isoseq_proteins_masked/genome.fa
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        set -euo pipefail
        export PATH=/opt/conda/bin:$PATH

        echo "[INFO] Running compleasm_to_hints.py" > logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        echo "[INFO] Genome: output/bam_isoseq_proteins_masked/genome.fa" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        echo "[INFO] Lineage: eukaryota_odb12" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        echo "[INFO] Library path: /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        echo "[INFO] Threads: 8" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log

        # Ensure shared download directory exists
        mkdir -p /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages

        # Log whether a pre-downloaded lineage is already in place.
        # compleasm uses a flat layout at {library_path}/{lineage}/.
        # If present, compleasm will reuse it instead of contacting busco-data.ezlab.org.
        COMPLEASM_LINEAGE="eukaryota_odb12"
        if [ -d "/projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/$COMPLEASM_LINEAGE" ]; then
            echo "[INFO] Found pre-downloaded compleasm lineage at /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/$COMPLEASM_LINEAGE" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        else
            echo "[INFO] No pre-downloaded lineage at /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/$COMPLEASM_LINEAGE; compleasm will attempt to download it" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        fi

        # Prevent host's ~/.local Python packages from shadowing container packages
        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1

        # compleasm's work dir goes to the node-local disk
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        scratch_dir outDir "compleasm_bam_isoseq_proteins_masked" "/tmp" \
            "$(need_gb 5 output/bam_isoseq_proteins_masked/genome.fa)" "$PWD/output/bam_isoseq_proteins_masked/compleasm_genome_out" 2>> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        trap 'rm -rf -- "$SCRATCH"' EXIT

        # Run our compleasm_to_hints.py with --library_path for pre-downloaded data
        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/compleasm_to_hints.py \
            -g output/bam_isoseq_proteins_masked/genome.fa \
            -d eukaryota_odb12 \
            -t 8 \
            -o output/bam_isoseq_proteins_masked/compleasm_hints.gff \
            -s "$outDir" \
            -L /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages \
            > output/bam_isoseq_proteins_masked/compleasm_to_hints.log 2>&1 || true

        # Ensure summary exists
        # compleasm creates summary.txt inside scratch_dir or a subdirectory
        mkdir -p $(dirname output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt)
        # Search for summary.txt in the scratch dir tree, top level first
        if [ -f "$outDir/summary.txt" ]; then
            FOUND_SUMMARY=$outDir/summary.txt
        else
            FOUND_SUMMARY=$(find "$outDir" -name "summary.txt" 2>/dev/null | head -1)
        fi
        if [ -n "$FOUND_SUMMARY" ] && [ -f "$FOUND_SUMMARY" ]; then
            # In the fallback the summary may already be the output file
            [ "$FOUND_SUMMARY" -ef output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt ] || cp "$FOUND_SUMMARY" output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt
        # Fall back to extracting from script stdout (captured in compleasm_log)
        elif grep -q "The following BUSCOs" output/bam_isoseq_proteins_masked/compleasm_to_hints.log 2>/dev/null; then
            grep -A20 "The following BUSCOs" output/bam_isoseq_proteins_masked/compleasm_to_hints.log | tail -n +2 > output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt
        elif grep -q "^S:" output/bam_isoseq_proteins_masked/compleasm_to_hints.log 2>/dev/null; then
            grep "^[SDFMN]:" output/bam_isoseq_proteins_masked/compleasm_to_hints.log > output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt
        else
            echo "Compleasm did not produce a summary. Check logs/bam_isoseq_proteins_masked/compleasm/compleasm.log for details." > output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt
        fi
        [ -s output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt ] || { echo "[ERROR] output/bam_isoseq_proteins_masked/compleasm_genome_out/summary.txt missing" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log; exit 1; }

        # Ensure hints file exists (may be empty if no BUSCOs found)
        touch output/bam_isoseq_proteins_masked/compleasm_hints.gff

        n_hints=$(wc -l < output/bam_isoseq_proteins_masked/compleasm_hints.gff)
        echo "[INFO] Generated $n_hints BUSCO-based hints" >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        if [ "$n_hints" -eq 0 ]; then
            echo "[WARNING] 0 BUSCO hints produced. Check output/bam_isoseq_proteins_masked/compleasm_to_hints.log for the actual compleasm error output." >> logs/bam_isoseq_proteins_masked/compleasm/compleasm.log
        fi

        # Record software versions
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        COMPLEASM_VER=$(grep -oP '__version__ = "\K[^"]+' /opt/compleasm_kit/_version.py 2>/dev/null || true)
        MINIPROT_VER=$(miniprot --version 2>&1 | head -1 || true)
        ( flock 9
          printf "compleasm\t%s\n" "$COMPLEASM_VER" >> "$VERSIONS_FILE"
          printf "miniprot\t%s\n" "$MINIPROT_VER" >> "$VERSIONS_FILE"
        ) 9>"$VERSIONS_FILE.lock"

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite compleasm "$REPORT_DIR"
        cite miniprot "$REPORT_DIR"

        # Remove compleasm genome internal files (miniprot alignments, working
        # dirs) in the fallback; on scratch the EXIT trap removes them.
        # Keep only summary.txt which is the Snakemake-tracked output.
        if [ -z "$SCRATCH" ]; then
            find output/bam_isoseq_proteins_masked/compleasm_genome_out -mindepth 1 -type f ! -name 'summary.txt' \
                -delete 2>/dev/null || true
            find output/bam_isoseq_proteins_masked/compleasm_genome_out -mindepth 1 -type d -empty \
                -delete 2>/dev/null || true
        fi
        
