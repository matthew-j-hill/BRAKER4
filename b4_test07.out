localrule run_prothint:
    input: output/bam_isoseq_proteins_masked/genome_masked.fa, ../../test_data/proteins.fa, output/bam_isoseq_proteins_masked/GeneMark-ES/genemark.gtf
    output: output/bam_isoseq_proteins_masked/prothint_hints.gff, output/bam_isoseq_proteins_masked/prothint/prothint.gff
    log: logs/bam_isoseq_proteins_masked/prothint/prothint.log
    jobid: 18
    benchmark: benchmarks/bam_isoseq_proteins_masked/prothint/prothint.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/prothint_hints.gff; Input files updated by another job: output/bam_isoseq_proteins_masked/genome_masked.fa, output/bam_isoseq_proteins_masked/GeneMark-ES/genemark.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        # Disable set -e for this rule: prothint.py returns non-zero on success
        # and various bash/Singularity/SLURM interactions make it impossible
        # to reliably capture. We check outputs explicitly instead.
        set +e
        set +o pipefail
        mkdir -p output/bam_isoseq_proteins_masked/prothint
        mkdir -p $(dirname logs/bam_isoseq_proteins_masked/prothint/prothint.log)

        WORKDIR=$(pwd)
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        GENOME_ABS=$(readlink -f output/bam_isoseq_proteins_masked/genome_masked.fa)
        PROTEINS_ABS=$(readlink -f ../../test_data/proteins.fa)
        GENEMARK_GTF_ABS=$(readlink -f output/bam_isoseq_proteins_masked/GeneMark-ES/genemark.gtf)
        finalDir=$(readlink -f output/bam_isoseq_proteins_masked/prothint)
        LOG_ABS=$WORKDIR/logs/bam_isoseq_proteins_masked/prothint/prothint.log
        HINTS_ABS=$WORKDIR/output/bam_isoseq_proteins_masked/prothint_hints.gff
        EVIDENCE_ABS=$WORKDIR/output/bam_isoseq_proteins_masked/prothint/prothint.gff

        # ProtHint's work files (DIAMOND, Spaln) go to the node-local disk.
        : > "$LOG_ABS"
        scratch_dir outDir "prothint_bam_isoseq_proteins_masked" "/tmp" \
            "$(need_gb 10 "$GENOME_ABS" "$PROTEINS_ABS")" "$finalDir" 2>> "$LOG_ABS"
        # also the ProtHint shadow tree next to the scratch dir ($outDir.bin)
        trap 'rm -rf -- "$SCRATCH" ${SCRATCH:+"$SCRATCH.bin"}' EXIT

        # ProtHint's Perl-threads Spaln dispatcher can hang after the last
        # batch is enqueued (#98). Run ProtHint from a symlinked copy of the
        # container's bin tree that uses scripts/spaln_dispatcher.py instead.
        SHADOW_DIR=$outDir.bin
        SHADOW_MSG=$(bash /projects/wenglab/testtube/matthew/manual/braker4/scripts/make_prothint_shadow.sh $SHADOW_DIR 2>&1)
        if [ -x $SHADOW_DIR/gmes/ProtHint/bin/prothint.py ]
        then
            PROTHINT=$SHADOW_DIR/gmes/ProtHint/bin/prothint.py
            SHADOW_MSG="[INFO] ProtHint run with the process-based Spaln dispatcher (#98)"
        else
            PROTHINT=prothint.py
            SHADOW_MSG="[WARNING] could not install the Spaln dispatcher fix (#98), used the container's ProtHint: $SHADOW_MSG"
        fi

        cd "$outDir"

        # Run prothint. Capture exit code without triggering set -e.
        # 'if cmd' is the ONLY set -e-safe pattern. No subshells.
        if $PROTHINT --threads=8 --geneMarkGtf $GENEMARK_GTF_ABS $GENOME_ABS $PROTEINS_ABS > "$outDir/prothint_run.log" 2>&1
        then
            PROTHINT_EXIT=0
        else
            PROTHINT_EXIT=$?
        fi

        cd $WORKDIR

        cat "$outDir/prothint_run.log" >> logs/bam_isoseq_proteins_masked/prothint/prothint.log 2>/dev/null || true
        echo "$SHADOW_MSG" >> logs/bam_isoseq_proteins_masked/prothint/prothint.log

        if [ ! -f "$outDir/prothint_augustus.gff" ]
        then
            echo "ERROR: ProtHint failed (exit=$PROTHINT_EXIT), no prothint_augustus.gff" >> logs/bam_isoseq_proteins_masked/prothint/prothint.log
            if [ "0" = "1" ] && grep -q "No homologous proteins were found by DIAMOND" "$outDir/prothint_run.log" 2>/dev/null
            then
                # no protein evidence at all: empty hints, the protein check
                # (check_protein_evidence) then decides for ES mode
                echo "FALLBACK: DIAMOND found no protein of ../../test_data/proteins.fa in the genome, so there are no protein hints." >> logs/bam_isoseq_proteins_masked/prothint/prothint.log
                echo "FALLBACK: auto_mode_fallback is on, the sample continues in ES mode. Set auto_mode_fallback = 0 in config.ini to fail here instead." >> logs/bam_isoseq_proteins_masked/prothint/prothint.log
                : > "$HINTS_ABS"
                : > "$EVIDENCE_ABS"
                rm -rf $SHADOW_DIR
                exit 0
            fi
            exit 1
        fi

        cp "$outDir/prothint_augustus.gff" "$HINTS_ABS"

        if [ -f "$outDir/prothint.gff" ]
        then
            cp "$outDir/prothint.gff" "$EVIDENCE_ABS" 2>/dev/null
        else
            touch "$EVIDENCE_ABS"
        fi
        # run_prothint_iter2 reuses iteration 1's Spaln alignments.
        copy_back "$outDir" "$finalDir" Spaln/spaln.gff
        if [ ! -f "$HINTS_ABS" ] || [ ! -f "$EVIDENCE_ABS" ]
        then
            echo "ERROR: output/bam_isoseq_proteins_masked/prothint_hints.gff or output/bam_isoseq_proteins_masked/prothint/prothint.gff missing after the copy back" >> logs/bam_isoseq_proteins_masked/prothint/prothint.log
            exit 1
        fi

        n_hints=$(wc -l < output/bam_isoseq_proteins_masked/prothint_hints.gff)
        echo "ProtHint generated $n_hints hints (exit=$PROTHINT_EXIT)" >> logs/bam_isoseq_proteins_masked/prothint/prothint.log

        # Record software versions
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        PH_VER=$(prothint.py --version 2>&1 | awk '{print $NF}' || true)
        DM_VER=$(diamond version 2>&1 | awk '{print $NF}' || true)
        SPALN_VER=$(/opt/ETP/bin/gmes/ProtHint/dependencies/spaln 2>&1 | grep -oP 'version \K\S+' | head -1 || true)
        ( flock 9
          printf "ProtHint\t%s\n" "$PH_VER" >> "$VERSIONS_FILE"
          printf "DIAMOND\t%s\n" "$DM_VER" >> "$VERSIONS_FILE"
          printf "Spaln\t%s\n" "$SPALN_VER" >> "$VERSIONS_FILE"
        ) 9>"$VERSIONS_FILE.lock"

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh || true
        cite prothint "$REPORT_DIR" || true
        cite diamond "$REPORT_DIR" || true
        cite spaln "$REPORT_DIR" || true

        # Remove ProTHint working files (DIAMOND databases, intermediate files).
        # Keep: prothint.gff (Snakemake output) and Spaln/spaln.gff (reused by
        # run_prothint_iter2 via --prevSpalnGff to avoid re-running Spaln).
        if [ -z "$SCRATCH" ]
        then
            find output/bam_isoseq_proteins_masked/prothint -mindepth 1 -type f \
                ! -name 'prothint.gff' \
                ! -path '*/Spaln/spaln.gff' \
                -delete 2>/dev/null || true
            find output/bam_isoseq_proteins_masked/prothint -mindepth 1 -type d -empty -delete 2>/dev/null || true
        fi
        rm -rf $SHADOW_DIR
        
