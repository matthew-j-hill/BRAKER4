localrule optimize_augustus:
    input: output/bam_isoseq_proteins_masked/train.gb.train, output/bam_isoseq_proteins_masked/train.gb.test, output/bam_isoseq_proteins_masked/augustus_training.log, augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/bam_isoseq_proteins_masked_rescuedB3_parameters.cfg.backup
    output: output/bam_isoseq_proteins_masked/train.gb.train.train, output/bam_isoseq_proteins_masked/train.gb.train.test, output/bam_isoseq_proteins_masked/optimize_augustus.log, output/bam_isoseq_proteins_masked/training_gene_summary.txt, output/bam_isoseq_proteins_masked/accuracy_after_training.txt, output/bam_isoseq_proteins_masked/accuracy_after_optimize.txt
    jobid: 21
    benchmark: benchmarks/bam_isoseq_proteins_masked/optimize_augustus/optimize_augustus.txt
