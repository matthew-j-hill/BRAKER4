localrule busco_genome:
    input: output/bam_isoseq_proteins_masked/genome_masked.fa
    output: output/bam_isoseq_proteins_masked/busco/genome/.done
    log: logs/bam_isoseq_proteins_masked/busco/busco_genome.log
    jobid: 40
    benchmark: benchmarks/bam_isoseq_proteins_masked/busco/busco_genome.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/busco/genome/.done; Input files updated by another job: output/bam_isoseq_proteins_masked/genome_masked.fa
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        set -euo pipefail
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        OUTDIR_ABS=$(readlink -f output/bam_isoseq_proteins_masked/busco)
        rm -rf "$OUTDIR_ABS/genome"
        finalDir=$OUTDIR_ABS

        scratch_dir outDir "busco_genome_bam_isoseq_proteins_masked" "/tmp" 20 "$finalDir" 2>> logs/bam_isoseq_proteins_masked/busco/busco_genome.log
        trap 'rm -rf -- "$SCRATCH"' EXIT

        mkdir -p /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads
        OFFLINE_FLAG=""
        # Check for dataset.cfg, not just the directory: compleasm and BUSCO
        # share the same /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/ default, but
        # `compleasm.py download` writes a compleasm-only layout (no
        # dataset.cfg). Only switch to --offline when the directory is a
        # valid BUSCO lineage.
        if [ -f "/projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/eukaryota_odb12/dataset.cfg" ]; then
            OFFLINE_FLAG="--offline"
            echo "[INFO] Found pre-downloaded lineage at /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads/lineages/eukaryota_odb12; running BUSCO with --offline" >> logs/bam_isoseq_proteins_masked/busco/busco_genome.log
        fi
        busco \
            -i output/bam_isoseq_proteins_masked/genome_masked.fa \
            -o genome \
            --out_path "$outDir" \
            -l eukaryota_odb12 \
            -m genome \
            -c 8 \
            --download_path /projects/wenglab/testtube/matthew/manual/braker4/shared_data/busco_downloads \
            $OFFLINE_FLAG \
            >> logs/bam_isoseq_proteins_masked/busco/busco_genome.log 2>&1

        # Keep only short_summary*.txt. busco_summary and collect_results
        # locate the summaries via find -name 'short_summary*.txt'. Nothing
        # downstream reads full_table.tsv, hmmer_output/, miniprot_output/
        # or busco_sequences/, which together run to several files per
        # BUSCO in the lineage (~6k files for chlorophyta_odb12, both
        # modes). On scratch the trap removes the rest. In the fallback the
        # tree is deleted here rather than in busco_summary so it is freed
        # as soon as this mode finishes and a failure further down the DAG
        # does not leave it behind.
        mapfile -t _keep < <(cd "$outDir" && find genome -name 'short_summary*.txt')
        # copy_back without names copies everything: only call it with names
        if [ ${#_keep[@]} -gt 0 ]; then
            copy_back "$outDir" "$finalDir" "${_keep[@]}"
        fi
        if ! find "$finalDir/genome" -name 'short_summary*.txt' 2>/dev/null | grep -q .; then
            echo "ERROR: no BUSCO short_summary*.txt in $finalDir/genome" >> logs/bam_isoseq_proteins_masked/busco/busco_genome.log
            exit 1
        fi
        if [ -z "$SCRATCH" ]; then
            find "$OUTDIR_ABS/genome" -mindepth 1 \( -type f -o -type l \) \
                ! -name 'short_summary*.txt' ! -name '.done' \
                -delete 2>/dev/null || true
            find "$OUTDIR_ABS/genome" -mindepth 1 -type d -empty \
                -delete 2>/dev/null || true
        fi

        # Record software version
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        BUSCO_VER=$(busco --version 2>&1 | head -1 || echo "unknown")
        ( flock 9; printf "BUSCO\t%s\n" "$BUSCO_VER" >> "$VERSIONS_FILE" ) 9>"$VERSIONS_FILE.lock"

        touch output/bam_isoseq_proteins_masked/busco/genome/.done
        
