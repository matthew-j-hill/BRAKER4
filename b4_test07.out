localrule filter_internal_stop_codons:
    input: output/bam_isoseq_proteins_masked/braker.rescued.gtf, output/bam_isoseq_proteins_masked/genome.fa
    output: output/bam_isoseq_proteins_masked/braker.filtered.gtf, output/bam_isoseq_proteins_masked/filter_stop_codons.log
    jobid: 3
    benchmark: benchmarks/bam_isoseq_proteins_masked/filter_internal_stop_codons/filter_internal_stop_codons.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/braker.filtered.gtf; Input files updated by another job: output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/braker.rescued.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1
        set -euo pipefail

        echo "[INFO] ===== FILTERING INTERNAL STOP CODONS =====" | tee output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO] Input GTF: output/bam_isoseq_proteins_masked/braker.rescued.gtf" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO] Output GTF: output/bam_isoseq_proteins_masked/braker.filtered.gtf" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        # Count genes before filtering
        GENES_BEFORE=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.rescued.gtf)
        TRANSCRIPTS_BEFORE=$(awk '$3=="transcript"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.rescued.gtf)
        echo "[INFO] Genes before filtering: $GENES_BEFORE" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO] Transcripts before filtering: $TRANSCRIPTS_BEFORE" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        # Extract protein sequences from merged GTF
        # Use modified local script that writes bad_genes.lst to specified output directory
        # This prevents parallel jobs from conflicting on bad_genes.lst in the root directory
        echo "[INFO] Extracting protein sequences to check for internal stop codons..." | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        # Use modified local script with -d flag to specify output directory for bad_genes.lst
        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
            -g output/bam_isoseq_proteins_masked/genome.fa \
            -f output/bam_isoseq_proteins_masked/braker.rescued.gtf \
            -o output/bam_isoseq_proteins_masked/braker.tsebra \
            -t 1 \
            -d output/bam_isoseq_proteins_masked \
            1> output/bam_isoseq_proteins_masked/getAnnoFasta_check.stdout \
            2> output/bam_isoseq_proteins_masked/getAnnoFasta_check.stderr || true

        STEM="output/bam_isoseq_proteins_masked/braker.tsebra"

        # Check if protein file was created
        if [ ! -f "$STEM.aa" ]; then
            echo "[ERROR] Failed to extract protein sequences!" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
            exit 1
        fi

        # Find transcript IDs with internal stop codons
        echo "[INFO] Identifying transcripts with internal stop codons..." | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        awk '
        BEGIN {
            bad_count = 0
        }
        /^>/ {
            # Extract transcript ID from header (e.g., >g1.t1 -> g1.t1)
            if (seq != "" && seq ~ /\*.*[A-Z]/) {
                bad_count++
                print tx_id
            }
            # Parse transcript ID from FASTA header
            tx_id = substr($1, 2)  # Remove leading >
            seq = ""
        }
        !/^>/ {seq = seq $0}
        END {
            if (seq != "" && seq ~ /\*.*[A-Z]/) {
                bad_count++
                print tx_id
            }
            print "TOTAL_BAD:" bad_count > "/dev/stderr"
        }
        ' "$STEM.aa" > output/bam_isoseq_proteins_masked/bad_transcript_ids.txt 2> output/bam_isoseq_proteins_masked/bad_tx_count.txt

        # Extract count and ensure it's a valid number (default to 0 if parsing fails)
        BAD_TX_COUNT=$(grep "TOTAL_BAD:" output/bam_isoseq_proteins_masked/bad_tx_count.txt | cut -d: -f2 || echo "0")
        # Remove any whitespace and ensure it's numeric
        BAD_TX_COUNT=${BAD_TX_COUNT:-0}
        BAD_TX_COUNT=${BAD_TX_COUNT// /}
        # If empty or non-numeric, set to 0
        if ! [[ "$BAD_TX_COUNT" =~ ^[0-9]+$ ]]; then
            BAD_TX_COUNT=0
        fi
        echo "[INFO] Found $BAD_TX_COUNT transcripts with internal stop codons" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        if [ "$BAD_TX_COUNT" -gt 0 ]; then
            echo "[INFO] Filtering out problematic transcripts..." | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

            # Create Python script to filter GTF by transcript ID
            # what about we dont ???

            # Run the filtering script
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/filter_gtf.py \
                output/bam_isoseq_proteins_masked/bad_transcript_ids.txt \
                output/bam_isoseq_proteins_masked/braker.rescued.gtf \
                output/bam_isoseq_proteins_masked/braker.filtered.gtf \
                2>&1 | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        else
            echo "[INFO] No problematic transcripts found - copying GTF as-is" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
            cp output/bam_isoseq_proteins_masked/braker.rescued.gtf output/bam_isoseq_proteins_masked/braker.filtered.gtf
        fi

        # Count genes after filtering
        GENES_AFTER=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.filtered.gtf)
        TRANSCRIPTS_AFTER=$(awk '$3=="transcript"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.filtered.gtf)
        GENES_REMOVED=$((GENES_BEFORE - GENES_AFTER))
        TRANSCRIPTS_REMOVED=$((TRANSCRIPTS_BEFORE - TRANSCRIPTS_AFTER))

        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO] FILTERING SUMMARY:" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Genes before: $GENES_BEFORE" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Genes after: $GENES_AFTER" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Genes removed: $GENES_REMOVED" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Transcripts before: $TRANSCRIPTS_BEFORE" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Transcripts after: $TRANSCRIPTS_AFTER" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO]   Transcripts removed: $TRANSCRIPTS_REMOVED" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        # Cleanup temporary files
        rm -f "$STEM.aa" "$STEM.codingseq"
        rm -f output/bam_isoseq_proteins_masked/getAnnoFasta_check.stdout output/bam_isoseq_proteins_masked/getAnnoFasta_check.stderr
        rm -f output/bam_isoseq_proteins_masked/bad_transcript_ids.txt output/bam_isoseq_proteins_masked/bad_tx_count.txt
        rm -f output/bam_isoseq_proteins_masked/filter_gtf.py

        # Cleanup bad_genes.lst if getAnnoFastaFromJoingenes.py created it
        # It should now be in the output directory, but check both locations for safety
        # Use test && to safely check files in bash strict mode
        test -f "output/bam_isoseq_proteins_masked/bad_genes.lst" && {
            echo "[INFO] Renaming bad_genes.lst in output directory" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
            mv -f output/bam_isoseq_proteins_masked/bad_genes.lst output/bam_isoseq_proteins_masked/bad_genes.tsebra.lst
            echo "[INFO] This file lists genes with stop codons that were filtered out" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
        } || true

        # Also check root directory in case it still appeared there
        # Use test && to safely check files in bash strict mode
        test -f "bad_genes.lst" && {
            echo "[WARNING] bad_genes.lst found in root directory - moving to output" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log
            mv -f bad_genes.lst output/bam_isoseq_proteins_masked/bad_genes.tsebra.lst
        } || true

        echo "[INFO] Stop codon filtering completed successfully" | tee -a output/bam_isoseq_proteins_masked/filter_stop_codons.log

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        
