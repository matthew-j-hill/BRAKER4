localrule merge_hints:
    input: output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff, output/bam_isoseq_proteins_masked/bam2hints.gff, output/bam_isoseq_proteins_masked/prothint_hints.gff, output/bam_isoseq_proteins_masked/compleasm_hints.gff
    output: output/bam_isoseq_proteins_masked/hintsfile.gff, output/bam_isoseq_proteins_masked/hints_statistics.txt
    jobid: 10
    benchmark: benchmarks/bam_isoseq_proteins_masked/merge_hints/merge_hints.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/hintsfile.gff; Input files updated by another job: output/bam_isoseq_proteins_masked/compleasm_hints.gff, output/bam_isoseq_proteins_masked/bam2hints.gff, output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff, output/bam_isoseq_proteins_masked/prothint_hints.gff
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        echo "[INFO] ========== MERGING HINTS FILES ==========" | tee output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "[INFO] Merging hints from multiple sources..." | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        # sort's temporary files go to the node-local disk
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/tmp_dir.sh
        scratch_dir outDir "mergehints_bam_isoseq_proteins_masked" "/tmp" \
            "$(need_gb 5 output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff output/bam_isoseq_proteins_masked/bam2hints.gff output/bam_isoseq_proteins_masked/prothint_hints.gff output/bam_isoseq_proteins_masked/compleasm_hints.gff)" "$PWD/$(dirname output/bam_isoseq_proteins_masked/hintsfile.gff)"
        trap 'rm -rf -- "$SCRATCH"' EXIT

        # Concatenate all input hint files into a temporary unsorted file
        TMP_RAW=output/bam_isoseq_proteins_masked/hintsfile.gff.raw
        > "$TMP_RAW"
        for hints_file in output/bam_isoseq_proteins_masked/etp_hints_isoseq.gff output/bam_isoseq_proteins_masked/bam2hints.gff output/bam_isoseq_proteins_masked/prothint_hints.gff output/bam_isoseq_proteins_masked/compleasm_hints.gff; do
            if [ -f "$hints_file" ] && [ -s "$hints_file" ]; then
                cat "$hints_file" >> "$TMP_RAW"
                echo "[INFO] Added $(basename $hints_file): $(wc -l < $hints_file) hints" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
            fi
        done

        # Split hints into two streams (mirrors braker.pl sub join_mult_hints
        # at scripts/braker.pl line 4785-4791):
        #   TMP_NOMERGE - hints with src=C AND a grp=/group= tag. These carry
        #                 per-gene group linkage that AUGUSTUS uses for
        #                 whole-gene hint scoring; coordinate-collapsing them
        #                 destroys the grp= identity and silently breaks
        #                 TSEBRA's intron_support gating. They are passed
        #                 through to the final hintsfile UNCHANGED.
        #   TMP_MERGE   - all other hints. These get sorted and run through
        #                 join_mult_hints.pl to collapse identical lines into
        #                 multiplicity-counted hints.
        # Final hintsfile is the concatenation of (joined merge stream) +
        # (passthrough nomerge stream), matching braker.pl line 4853.
        N_RAW=$(wc -l < "$TMP_RAW" || echo 0)
        TMP_MERGE=output/bam_isoseq_proteins_masked/hintsfile.gff.merge
        TMP_NOMERGE=output/bam_isoseq_proteins_masked/hintsfile.gff.nomerge
        awk -F'\t' '{
            if ($9 ~ /src=C/ && ($9 ~ /grp=/ || $9 ~ /group=/)) {
                print > "'"$TMP_NOMERGE"'"
            } else {
                print > "'"$TMP_MERGE"'"
            }
        }' "$TMP_RAW"
        touch "$TMP_MERGE" "$TMP_NOMERGE"
        N_NOMERGE=$(wc -l < "$TMP_NOMERGE")
        N_MERGE_IN=$(wc -l < "$TMP_MERGE")
        echo "[INFO] split: $N_NOMERGE src=C grp=* hints (passthrough), $N_MERGE_IN merge candidates" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        # Sort key order matches braker.pl sub join_mult_hints
        # (scripts/braker.pl line 4820): coordinate-based, then stable-sorted
        # by type, then by chromosome.
        # join_mult_hints.pl can exit non-zero even when it succeeds and
        # writes valid output (same flaky behavior documented in
        # run_genemark_etp.smk and README.md for prothint.py/get_etp_hints.py).
        # Snakemake 8's SLURM executor re-enables -e/pipefail, so disable both
        # around the pipe and validate the output ourselves afterwards.
        TMP_JOINED=output/bam_isoseq_proteins_masked/hintsfile.gff.joined
        set +e
        set +o pipefail
        cat "$TMP_MERGE" \
            | sort -T "$outDir" -n -k 4,4 \
            | sort -T "$outDir" -s -n -k 5,5 \
            | sort -T "$outDir" -s -n -k 3,3 \
            | sort -T "$outDir" -s -k 1,1 \
            | join_mult_hints.pl \
            > "$TMP_JOINED"
        JOIN_EXIT=$?
        if [ -s "$TMP_MERGE" ] && [ ! -s "$TMP_JOINED" ]; then
            echo "[ERROR] join_mult_hints.pl produced no output (exit=$JOIN_EXIT) from $N_MERGE_IN merge candidates" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
            exit 1
        fi
        set -e
        set -o pipefail
        N_JOINED_OUT=$(wc -l < "$TMP_JOINED")
        echo "[INFO] join_mult_hints.pl: $N_MERGE_IN -> $N_JOINED_OUT collapsed hints" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        # Concatenate joined merge stream + passthrough nomerge stream
        cat "$TMP_JOINED" "$TMP_NOMERGE" > output/bam_isoseq_proteins_masked/hintsfile.gff
        rm -f "$TMP_RAW" "$TMP_MERGE" "$TMP_NOMERGE" "$TMP_JOINED"
        N_FINAL=$(wc -l < output/bam_isoseq_proteins_masked/hintsfile.gff || echo 0)
        echo "[INFO] Final hintsfile: $N_RAW raw -> $N_FINAL hints (joined+passthrough)" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        # Count hints by type and source
        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "===== HINTS STATISTICS =====" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        echo "Total hints: $(grep -c '^' output/bam_isoseq_proteins_masked/hintsfile.gff || echo 0)" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        echo "By hint type:" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        awk '{print $3}' output/bam_isoseq_proteins_masked/hintsfile.gff | sort | uniq -c | sort -rn | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        # POSIX-portable: awk in the BRAKER container is mawk, which does
        # NOT support gawk's 3-arg match($str, regex, array). Use sub() to
        # extract the src= field instead.
        echo "By source:" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        awk '$9 ~ /src=/ { s=$9; sub(/.*src=/, "", s); sub(/;.*/, "", s); print s }' output/bam_isoseq_proteins_masked/hintsfile.gff | sort | uniq -c | sort -rn | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        echo "Breakdown by source and type:" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        awk '{
            type=$3;
            if ($9 ~ /src=/) {
                src=$9;
                sub(/.*src=/, "", src);
                sub(/;.*/, "", src);
            } else {
                src="unknown";
            }
            print src"\t"type
        }' output/bam_isoseq_proteins_masked/hintsfile.gff | sort | uniq -c | sort -k2,2 -k3,3 | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt

        echo "" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        echo "[INFO] Hints merging completed: output/bam_isoseq_proteins_masked/hintsfile.gff" | tee -a output/bam_isoseq_proteins_masked/hints_statistics.txt
        
