            -o $STEM \
            -t 1 \
            2>> logs/bam_isoseq_proteins_masked/longest_isoform/longest_isoform.log

        n_prot=$(grep -c "^>" output/bam_isoseq_proteins_masked/braker.longest.aa || echo 0)
        echo "Extracted $n_prot proteins" >> logs/bam_isoseq_proteins_masked/longest_isoform/longest_isoform.log
        
