localrule fix_in_frame_stop_codons:
    input: output/bam_isoseq_proteins_masked/augustus.hints.gtf, output/bam_isoseq_proteins_masked/bad_genes.lst, output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/hintsfile.gff, augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/bam_isoseq_proteins_masked_rescuedB3_parameters.cfg.backup
    output: output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf, output/bam_isoseq_proteins_masked/augustus.hints.fixed.codingseq, output/bam_isoseq_proteins_masked/augustus.hints.fixed.aa, output/bam_isoseq_proteins_masked/fix_in_frame_stop_codons.log
    jobid: 7
    benchmark: benchmarks/bam_isoseq_proteins_masked/fix_in_frame_stop_codons/fix_in_frame_stop_codons.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf; Input files updated by another job: output/bam_isoseq_proteins_masked/augustus.hints.gtf, output/bam_isoseq_proteins_masked/genome.fa, augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/bam_isoseq_proteins_masked_rescuedB3_parameters.cfg.backup, output/bam_isoseq_proteins_masked/bad_genes.lst, output/bam_isoseq_proteins_masked/hintsfile.gff
    wildcards: sample=bam_isoseq_proteins_masked
    threads: 8
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1
        set -euo pipefail

        export AUGUSTUS_CONFIG_PATH=/projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config

        echo "[INFO] ===== FIXING IN-FRAME STOP CODONS ====="

        # Create local symlink to genome to allow index file creation
        LOCAL_GENOME=output/bam_isoseq_proteins_masked/genome.fa
        if [ ! -e "$LOCAL_GENOME" ]; then
            ln -s output/bam_isoseq_proteins_masked/genome.fa $LOCAL_GENOME
        fi

        # Check if there are any bad genes to fix
        if [ ! -s output/bam_isoseq_proteins_masked/bad_genes.lst ]; then
            echo "[INFO] No genes with in-frame stop codons to fix"
            echo "[INFO] Copying original files..."
            cp output/bam_isoseq_proteins_masked/augustus.hints.gtf output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf

            # Extract sequences from original GTF using modified local script
            STEM=$(echo output/bam_isoseq_proteins_masked/augustus.hints.fixed.codingseq | sed 's/\.codingseq$//')
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
                -g $LOCAL_GENOME \
                -f output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf \
                -o $STEM \
                -t 1 \
                -d output/bam_isoseq_proteins_masked

            echo "[INFO] No fixing needed" > output/bam_isoseq_proteins_masked/fix_in_frame_stop_codons.log
        else
            BAD_GENES=$(wc -l < output/bam_isoseq_proteins_masked/bad_genes.lst)
            echo "[INFO] Fixing $BAD_GENES genes with in-frame stop codons..."

            # Run fix_in_frame_stop_codon_genes.py (local modified version)
            # Note: Using local script to control temp file locations
            # -m on: BRAKER4 always soft-masks, so the re-prediction must
            # honour repeat regions the same way the original AUGUSTUS run did.
            # braker.pl picks -m on/off conditionally on $soft_mask; in BRAKER4
            # the genome is always soft-masked, so the answer is always "on".
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/fix_in_frame_stop_codon_genes.py \
                -g $LOCAL_GENOME \
                -t output/bam_isoseq_proteins_masked/augustus.hints.gtf \
                -b output/bam_isoseq_proteins_masked/bad_genes.lst \
                -o output/bam_isoseq_proteins_masked/augustus.hints_fix_ifs_ \
                -s bam_isoseq_proteins_masked \
                -m on \
                -u off \
                -U off \
                -a /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config \
                -C /opt/cdbfasta \
                -A /opt/Augustus/bin \
                -S /opt/Augustus/scripts \
                -H output/bam_isoseq_proteins_masked/hintsfile.gff \
                -e /opt/BRAKER/scripts/cfg/etp.cfg \
                -w output/bam_isoseq_proteins_masked \
                -c 8 \
                --additional_aug_args "--allow_hinted_splicesites=gcag,atac " \
                2>&1 | tee output/bam_isoseq_proteins_masked/fix_in_frame_stop_codons.log

            # Move fixed GTF to output location
            mv output/bam_isoseq_proteins_masked/augustus.hints_fix_ifs_.gtf output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf

            # Extract sequences from fixed GTF using modified local script
            echo "[INFO] Re-extracting sequences from fixed GTF..."
            STEM=$(echo output/bam_isoseq_proteins_masked/augustus.hints.fixed.codingseq | sed 's/\.codingseq$//')
            python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
                -g $LOCAL_GENOME \
                -f output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf \
                -o $STEM \
                -t 1 \
                -d output/bam_isoseq_proteins_masked

            FIXED_GENES=$(wc -l < output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf)
            echo "[INFO] Fixed GTF has $FIXED_GENES lines"
        fi

        # Count final sequences
        CODING_SEQ=$(grep -c "^>" output/bam_isoseq_proteins_masked/augustus.hints.fixed.codingseq || echo 0)
        AA_SEQ=$(grep -c "^>" output/bam_isoseq_proteins_masked/augustus.hints.fixed.aa || echo 0)

        echo "[INFO] Final coding sequences: $CODING_SEQ"
        echo "[INFO] Final protein sequences: $AA_SEQ"
        echo "[INFO] ======================================="

        # Cleanup empty log files
        for logfile in output/bam_isoseq_proteins_masked/getAnnoFasta.stdout output/bam_isoseq_proteins_masked/getAnnoFasta.stderr; do
            if [ -f "$logfile" ] && [ ! -s "$logfile" ]; then
                rm "$logfile"
            fi
        done
        
