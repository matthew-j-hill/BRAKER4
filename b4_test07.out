localrule create_new_species:
    input: augustus_config/.copy_complete
    output: augustus_config/species/bam_isoseq_proteins_masked_rescuedB3, augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/.species_created
    log: logs/bam_isoseq_proteins_masked/create_new_species/create_new_species.log
    jobid: 28
    benchmark: benchmarks/bam_isoseq_proteins_masked/create_new_species/create_new_species.txt
    reason: Missing output files: augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/.species_created; Input files updated by another job: augustus_config/.copy_complete
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail
        mkdir -p $(dirname logs/bam_isoseq_proteins_masked/create_new_species/create_new_species.log)
        exec > logs/bam_isoseq_proteins_masked/create_new_species/create_new_species.log 2>&1

        # Set AUGUSTUS_CONFIG_PATH to our local copy (absolute path)
        export AUGUSTUS_CONFIG_PATH=/projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config

        # Use file-based locking to prevent race conditions when creating species
        LOCKFILE="$AUGUSTUS_CONFIG_PATH/species/.species_creation.lock"
        exec 200>"$LOCKFILE"
        flock -x 200

        echo "[INFO] Lock acquired for species creation"
        echo "[INFO] AUGUSTUS_CONFIG_PATH set to: $AUGUSTUS_CONFIG_PATH"
        echo "[INFO] Creating new AUGUSTUS species: bam_isoseq_proteins_masked"
        echo "[INFO] Current working directory: $(pwd)"
        echo "[INFO] Checking if config directory is writable..."
        test -w "$AUGUSTUS_CONFIG_PATH" && echo "[INFO] Config directory is writable" || echo "[ERROR] Config directory is NOT writable"

        # Check if species parameter files already exist
        if [ -f "$AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg" ]; then
            echo "[INFO] Species bam_isoseq_proteins_masked already exists with parameter files. Skipping creation."
        else
            echo "[INFO] Running new_species.pl..."
            # Create new species using new_species.pl
            if ! new_species.pl --species=bam_isoseq_proteins_masked; then
                echo "[ERROR] new_species.pl failed for species bam_isoseq_proteins_masked in $AUGUSTUS_CONFIG_PATH/species" >&2
                echo "  Check that $AUGUSTUS_CONFIG_PATH is writable and contains species/generic, and that no" >&2
                echo "  incomplete $AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked is left over from an earlier run." >&2
                exit 1
            fi
            if [ ! -f "$AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg" ]; then
                echo "[ERROR] new_species.pl did not write bam_isoseq_proteins_masked_parameters.cfg in $AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked" >&2
                exit 1
            fi

            echo "[INFO] Successfully created species bam_isoseq_proteins_masked"
        fi

        # Create marker file
        touch augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/.species_created

        echo "[INFO] Species directory: $AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked"
        echo "[INFO] Contents:"
        ls -la "$AUGUSTUS_CONFIG_PATH/species/bam_isoseq_proteins_masked" | head -10 || true

        # Release lock
        flock -u 200
        rm -f "$LOCKFILE"
        
