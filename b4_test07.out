    reason: Missing output files: output/bam_isoseq_proteins_masked/flanking_dna_value.txt; Input files updated by another job: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        # Create output directory if it doesn't exist
        mkdir -p $(dirname output/bam_isoseq_proteins_masked/genome_gmst_for_HC.flanking.gtf)
        echo "[INFO] Created output directory: $(dirname output/bam_isoseq_proteins_masked/genome_gmst_for_HC.flanking.gtf)"

        # Run computeFlankingRegion.pl and capture output to file
        computeFlankingRegion.pl output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf > output/bam_isoseq_proteins_masked/genome_gmst_for_HC.flanking.gtf

        # Extract the flanking DNA value from the output file
        # Format: "The flanking_DNA value is: 1094 (the Minimum of 10 000 and 1094"
