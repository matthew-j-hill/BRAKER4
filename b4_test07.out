localrule add_utr:
    input: output/bam_isoseq_proteins_masked/braker.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/rnaseq/stringtie/transcripts_merged.gff, output/bam_isoseq_proteins_masked/stringtie/isoseq.gtf
    output: output/bam_isoseq_proteins_masked/braker_utr.gtf
    log: logs/bam_isoseq_proteins_masked/add_utr/add_utr.log
    jobid: 35
    benchmark: benchmarks/bam_isoseq_proteins_masked/add_utr/add_utr.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/braker_utr.gtf; Input files updated by another job: output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/rnaseq/stringtie/transcripts_merged.gff, output/bam_isoseq_proteins_masked/stringtie/isoseq.gtf, output/bam_isoseq_proteins_masked/braker.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=32000, mem_mib=30518, runtime=1440


        set -euo pipefail
        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1
        echo "Decorating gene predictions with UTRs from StringTie..." > logs/bam_isoseq_proteins_masked/add_utr/add_utr.log

        # Dual mode: UTRs from the IsoSeq-only assembly take priority (#29)
        LR_OPT=""
        if [ -n "output/bam_isoseq_proteins_masked/stringtie/isoseq.gtf" ]; then
            LR_OPT="-l output/bam_isoseq_proteins_masked/stringtie/isoseq.gtf"
        fi

        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/stringtie2utr.py \
            -g output/bam_isoseq_proteins_masked/braker.gtf \
            -s output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/rnaseq/stringtie/transcripts_merged.gff \
            $LR_OPT \
            -o output/bam_isoseq_proteins_masked/braker_utr.gtf \
            2>> logs/bam_isoseq_proteins_masked/add_utr/add_utr.log

        # Every gene and transcript on one sequence and strand, spans consistent (#62)
        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/check_gtf_loci.py output/bam_isoseq_proteins_masked/braker_utr.gtf 2>> logs/bam_isoseq_proteins_masked/add_utr/add_utr.log

        n_genes=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker_utr.gtf)
        n_utr=$(awk '$3=="five_prime_UTR"||$3=="three_prime_UTR"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker_utr.gtf)
        echo "Output: $n_genes genes, $n_utr UTR features" >> logs/bam_isoseq_proteins_masked/add_utr/add_utr.log

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite stringtie "$REPORT_DIR"
        
