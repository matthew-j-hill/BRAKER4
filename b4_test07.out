localrule run_tsebra:
    input: output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/hintsfile.gff, output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf, output/bam_isoseq_proteins_masked/genome.fa.fai
    output: output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf, output/bam_isoseq_proteins_masked/tsebra.log
    jobid: 6
    benchmark: benchmarks/bam_isoseq_proteins_masked/run_tsebra/run_tsebra.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf; Input files updated by another job: output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf, output/bam_isoseq_proteins_masked/genome.fa.fai, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf, output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf, output/bam_isoseq_proteins_masked/hintsfile.gff
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        set -euo pipefail

        OUT_DIR=$(dirname output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf)

        echo "[INFO] ===== RUNNING TSEBRA TO MERGE PREDICTIONS =====" | tee output/bam_isoseq_proteins_masked/tsebra.log
        echo "[INFO] Mode: dual" | tee -a output/bam_isoseq_proteins_masked/tsebra.log

        # braker3.cfg matches braker.pl. Default has intron_support=1.0,
        # which is the load-bearing threshold that filters AUGUSTUS
        # predictions whose intron chains aren't fully supported by hints.
        TSEBRA_CFG=/opt/TSEBRA/config/braker3.cfg
        if [ ! -f "$TSEBRA_CFG" ]; then
            echo "[ERROR] braker3.cfg not found at $TSEBRA_CFG" | tee -a output/bam_isoseq_proteins_masked/tsebra.log
            exit 1
        fi
        echo "[INFO] TSEBRA config: $TSEBRA_CFG" | tee -a output/bam_isoseq_proteins_masked/tsebra.log

        GENOME_SIZE=$(awk '{sum+=$2} END {printf "%.0f\n", sum+0}' output/bam_isoseq_proteins_masked/genome.fa.fai)
        # [PARAMS] filter_single_exon_genes: auto (> 300 Mbp), 1 (always), 0 (never)
        FILTER_SE_MODE=auto
        FILTER_SE_ARG=""
        if [ "$FILTER_SE_MODE" = "1" ] || { [ "$FILTER_SE_MODE" = "auto" ] && [ "$GENOME_SIZE" -gt 300000000 ]; }; then
            FILTER_SE_ARG="--filter_single_exon_genes"
            echo "[INFO] Genome $GENOME_SIZE bp, filter_single_exon_genes=$FILTER_SE_MODE: single-exon gene filter active" | tee -a output/bam_isoseq_proteins_masked/tsebra.log
        else
            echo "[INFO] Genome $GENOME_SIZE bp, filter_single_exon_genes=$FILTER_SE_MODE: single-exon gene filter inactive" | tee -a output/bam_isoseq_proteins_masked/tsebra.log
        fi

        TSEBRA_TMP=output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf.tmp

        case "dual" in
            etp|isoseq|dual)
                # Single ETP-style merge: AUGUSTUS + raw GeneMark predictions
                # are CANDIDATES (filtered against the hints), HC training
                # genes are FORCED via --keep_gtf. Mirrors braker.pl ETP.
                AUG_GENES=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf)
                GM_GENES=$(awk -F'\t' '$3=="CDS"' output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf | grep -oE 'gene_id "[^"]+"' | sort -u | wc -l)
                KEEP_GENES=$(grep -oE 'gene_id "[^"]+"' output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf | sort -u | wc -l)
                echo "[INFO] Inputs: AUGUSTUS=$AUG_GENES, GeneMark=$GM_GENES (candidates), training=$KEEP_GENES (forced)" | tee -a output/bam_isoseq_proteins_masked/tsebra.log

                tsebra.py \
                    --gtf output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf,output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/genemark.gtf \
                    --keep_gtf output/bam_isoseq_proteins_masked/GeneMark-ETP-isoseq/training.gtf \
                    --hintfiles output/bam_isoseq_proteins_masked/hintsfile.gff \
                    $FILTER_SE_ARG \
                    --cfg $TSEBRA_CFG \
                    --out $TSEBRA_TMP 2>&1 | tee -a output/bam_isoseq_proteins_masked/tsebra.log
                ;;

            *)
                # ES / EP / ET — keep-everything (matches braker.pl). For ES,
                # genemark.f.good.gtf is the unfiltered sorted set; for EP/ET
                # it's the filterGenemark.pl-filtered "good" set.
                AUG_GENES=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf)
                KEEP_GENES=$(grep -oE 'gene_id "[^"]+"' output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf | sort -u | wc -l)
                echo "[INFO] Inputs: AUGUSTUS=$AUG_GENES, GeneMark good=$KEEP_GENES (both forced)" | tee -a output/bam_isoseq_proteins_masked/tsebra.log

                # ES has no hints — only pass --hintfiles if non-empty.
                HINTS_ARG=""
                if [ -s output/bam_isoseq_proteins_masked/hintsfile.gff ]; then
                    HINTS_ARG="--hintfiles output/bam_isoseq_proteins_masked/hintsfile.gff"
                fi

                tsebra.py \
                    --keep_gtf output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf,output/bam_isoseq_proteins_masked/augustus.hints.fixed.gtf \
                    $HINTS_ARG \
                    $FILTER_SE_ARG \
                    --cfg $TSEBRA_CFG \
                    --out $TSEBRA_TMP 2>&1 | tee -a output/bam_isoseq_proteins_masked/tsebra.log
                ;;
        esac

        echo "[INFO] Renaming gene and transcript IDs..." | tee -a output/bam_isoseq_proteins_masked/tsebra.log
        /opt/TSEBRA/bin/rename_gtf.py \
            --gtf $TSEBRA_TMP \
            --out output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf \
            2>&1 | tee -a output/bam_isoseq_proteins_masked/tsebra.log
        rm -f $TSEBRA_TMP

        MERGED_GENES=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf)
        MERGED_TX=$(awk '$3=="transcript"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.tsebra.raw.gtf)
        echo "[INFO] Output: $MERGED_GENES genes, $MERGED_TX transcripts" | tee -a output/bam_isoseq_proteins_masked/tsebra.log
        echo "[INFO] TSEBRA merge completed successfully" | tee -a output/bam_isoseq_proteins_masked/tsebra.log

        # Record software version (TSEBRA has no --version flag)
        VERSIONS_FILE=output/bam_isoseq_proteins_masked/software_versions.tsv
        TSEBRA_COMMIT=$(grep 'refs/remotes/origin/main' /opt/TSEBRA/.git/packed-refs 2>/dev/null | awk '{print substr($1,1,7)}' || true)
        ( flock 9; printf "TSEBRA\tcommit %s\n" "$TSEBRA_COMMIT" >> "$VERSIONS_FILE" ) 9>"$VERSIONS_FILE.lock"

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        cite tsebra "$REPORT_DIR"
        
