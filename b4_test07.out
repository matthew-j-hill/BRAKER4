localrule extract_final_sequences:
    input: output/bam_isoseq_proteins_masked/braker.gtf, output/bam_isoseq_proteins_masked/genome.fa
    output: output/bam_isoseq_proteins_masked/braker.codingseq, output/bam_isoseq_proteins_masked/braker.aa
    jobid: 32
    benchmark: benchmarks/bam_isoseq_proteins_masked/extract_final_sequences/extract_final_sequences.txt
    reason: Missing output files: output/bam_isoseq_proteins_masked/braker.aa, output/bam_isoseq_proteins_masked/braker.codingseq; Input files updated by another job: output/bam_isoseq_proteins_masked/genome.fa, output/bam_isoseq_proteins_masked/braker.gtf
    wildcards: sample=bam_isoseq_proteins_masked
    resources: tmpdir=/tmp, mem_mb=8000, mem_mib=7630, runtime=1440


        export PATH=/opt/conda/bin:$PATH
        export PYTHONNOUSERSITE=1
        set -euo pipefail

        echo "[INFO] ===== EXTRACTING FINAL SEQUENCES ====="
        echo "[INFO] Using braker.gtf from TSEBRA (already merged and renamed)"

        # Extract sequences from braker.gtf using modified local script
        STEM=$(echo output/bam_isoseq_proteins_masked/braker.codingseq | sed 's/\.codingseq$//')
        python3 /projects/wenglab/testtube/matthew/manual/braker4/scripts/getAnnoFastaFromJoingenes.py \
            -g output/bam_isoseq_proteins_masked/genome.fa \
            -f output/bam_isoseq_proteins_masked/braker.gtf \
            -o $STEM \
            -t 1 \
            -d output/bam_isoseq_proteins_masked \
            1> output/bam_isoseq_proteins_masked/getAnnoFasta_final.stdout \
            2> output/bam_isoseq_proteins_masked/getAnnoFasta_final.stderr

        GENES_GTF=$(awk '$3=="gene"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.gtf)
        TRANSCRIPTS_GTF=$(awk '$3=="transcript"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.gtf)
        CDS_COUNT=$(awk '$3=="CDS"{n++}END{print n+0}' output/bam_isoseq_proteins_masked/braker.gtf)
        CODING_SEQ=$(grep -c "^>" output/bam_isoseq_proteins_masked/braker.codingseq || echo 0)
        AA_SEQ=$(grep -c "^>" output/bam_isoseq_proteins_masked/braker.aa || echo 0)

        echo "[INFO] Final gene predictions:"
        echo "[INFO]   Genes: $GENES_GTF"
        echo "[INFO]   Transcripts: $TRANSCRIPTS_GTF"
        echo "[INFO]   CDS features: $CDS_COUNT"
        echo "[INFO]   Coding sequences: $CODING_SEQ"
        echo "[INFO]   Protein sequences: $AA_SEQ"

        # Verify no internal in-frame stop codons in protein sequences
        # (This is a sanity check - filtering should have removed all such genes)
        echo "[INFO] Verifying no internal stop codons in protein sequences..."

        awk '
        /^>/ {
            if (seq != "" && seq ~ /\*.*[A-Z]/) {
                internal_stops++
            }
            seq=""
        }
        !/^>/ {seq=seq$0}
        END {
            if (seq != "" && seq ~ /\*.*[A-Z]/) {
                internal_stops++
            }
            print internal_stops + 0
        }
        ' output/bam_isoseq_proteins_masked/braker.aa > output/bam_isoseq_proteins_masked/internal_stops_verify.txt

        INTERNAL_STOPS=$(cat output/bam_isoseq_proteins_masked/internal_stops_verify.txt)

        if [ "$INTERNAL_STOPS" -gt 0 ]; then
            echo "[ERROR] VERIFICATION FAILED: Found $INTERNAL_STOPS sequences with internal stop codons!"
            echo "[ERROR] This should not happen - filtering step may have failed!"
            exit 1
        else
            echo "[INFO] ✓ Verification passed: No internal stop codons found"
            rm -f output/bam_isoseq_proteins_masked/internal_stops_verify.txt
        fi

        echo "[INFO] ======================================="

        # Cleanup empty log files
        for logfile in output/bam_isoseq_proteins_masked/getAnnoFasta_final.stdout output/bam_isoseq_proteins_masked/getAnnoFasta_final.stderr; do
            if [ -f "$logfile" ] && [ ! -s "$logfile" ]; then
                rm "$logfile"
            fi
        done

        # Cleanup bad_genes.lst if it was created (shouldn't happen after filtering)
        # Use test && to safely check files in bash strict mode
        test -f "bad_genes.lst" && {
            echo "[WARNING] bad_genes.lst was created in root directory - moving to output"
            mv bad_genes.lst output/bam_isoseq_proteins_masked/bad_genes.lst.unexpected
        } || true
        
