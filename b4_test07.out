        set -euo pipefail

        # Set AUGUSTUS_CONFIG_PATH to our local copy
        export AUGUSTUS_CONFIG_PATH=/projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config

        echo "[INFO] ========== AUGUSTUS TRAINING ==========" | tee output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO] AUGUSTUS_CONFIG_PATH: $AUGUSTUS_CONFIG_PATH" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO] Species: bam_isoseq_proteins_masked" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO] Parameters file: /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Backup original parameters
        cp /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg augustus_config/species/bam_isoseq_proteins_masked_rescuedB3/bam_isoseq_proteins_masked_rescuedB3_parameters.cfg.backup
        echo "[INFO] Backed up original parameters" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Count total training genes
        TOTAL_GENES=$(grep -c "^LOCUS" output/bam_isoseq_proteins_masked/train.gb.train || echo 0)
        echo "[INFO] Total training genes (test set held out): $TOTAL_GENES" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Step 1: Set stopCodonExcludedFromCDS to true
        echo "[INFO] Setting stopCodonExcludedFromCDS to true" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        sed -i 's/^\(stopCodonExcludedFromCDS\s\+\)\S\+/\1true/' /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg

        # Step 2: Run etraining with stopCodonExcludedFromCDS=true
        echo "[INFO] Running etraining (first pass, stopCodonExcludedFromCDS=true)..." | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        etraining --species=bam_isoseq_proteins_masked --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
            output/bam_isoseq_proteins_masked/train.gb.train \
            1> output/bam_isoseq_proteins_masked/etraining.train.stdout \
            2> output/bam_isoseq_proteins_masked/etraining.train.stderr || true

        # Step 3: Check error rate for missing stop codons
        MISSING_STOP_ERRORS=$(grep -c "exon doesn't end in stop codon" output/bam_isoseq_proteins_masked/etraining.train.stderr || echo 0)

        # Avoid division by zero
        if [ "$TOTAL_GENES" -eq 0 ]; then
            ERROR_RATE="0.0000"
        else
            ERROR_RATE=$(awk "BEGIN {printf \"%.4f\", $MISSING_STOP_ERRORS/$TOTAL_GENES}")
        fi

        echo "[INFO] Missing stop codon errors: $MISSING_STOP_ERRORS" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO] Error rate: $ERROR_RATE" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Step 4: If error rate >= 0.5, set stopCodonExcludedFromCDS to false and re-run
        if awk "BEGIN {exit !($ERROR_RATE >= 0.5)}"; then
            echo "[INFO] Error rate >= 0.5, setting stopCodonExcludedFromCDS to false" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
            sed -i 's/^\(stopCodonExcludedFromCDS\s\+\)\S\+/\1false/' /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg

            echo "[INFO] Running etraining (second pass, stopCodonExcludedFromCDS=false)..." | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
            etraining --species=bam_isoseq_proteins_masked --AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH \
                output/bam_isoseq_proteins_masked/train.gb.train \
                1> output/bam_isoseq_proteins_masked/etraining.train.stdout \
                2> output/bam_isoseq_proteins_masked/etraining.train.stderr || true
        else
            echo "[INFO] Error rate < 0.5, keeping stopCodonExcludedFromCDS=true" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        fi

        # Step 5: Extract stop codon frequencies from etraining output
        echo "[INFO] Extracting stop codon frequencies from training output..." | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        FREQ_TAG=$(grep "tag:" output/bam_isoseq_proteins_masked/etraining.train.stdout | tail -1 | sed -E 's/.*\(([0-9.]+)\).*/\1/' || echo "0.33")
        FREQ_TAA=$(grep "taa:" output/bam_isoseq_proteins_masked/etraining.train.stdout | tail -1 | sed -E 's/.*\(([0-9.]+)\).*/\1/' || echo "0.33")
        FREQ_TGA=$(grep "tga:" output/bam_isoseq_proteins_masked/etraining.train.stdout | tail -1 | sed -E 's/.*\(([0-9.]+)\).*/\1/' || echo "0.34")

        echo "[INFO] Stop codon frequencies:" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO]   TAG (amber): $FREQ_TAG" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO]   TAA (ochre): $FREQ_TAA" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO]   TGA (opal):  $FREQ_TGA" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Step 6: Update species parameters with observed frequencies
        echo "[INFO] Setting stop codon frequencies in species parameters..." | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # For alternative genetic codes, override stop codon probabilities:
        # Code 6/29 (ciliate): TGA codes for Trp, not a stop codon → opalprob=0
        if [ "1" != "1" ]; then
            echo "[INFO] Alternative translation table 1 detected" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
            if [ "1" = "6" ] || [ "1" = "29" ]; then
                echo "[INFO] Code 6/29: TGA encodes Trp, setting opalprob to 0" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
                FREQ_TGA="0"
                # Renormalize TAG and TAA to sum to 1
                FREQ_TAG=$(awk "BEGIN {printf \"%.4f\", $FREQ_TAG / ($FREQ_TAG + $FREQ_TAA)}")
                FREQ_TAA=$(awk "BEGIN {printf \"%.4f\", $FREQ_TAA / ($FREQ_TAG + $FREQ_TAA)}")
            fi
        fi

        sed -i "s#^\(/Constant/amberprob\s\+\)\S\+#\1$FREQ_TAG#" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg
        sed -i "s#^\(/Constant/ochreprob\s\+\)\S\+#\1$FREQ_TAA#" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg
        sed -i "s#^\(/Constant/opalprob\s\+\)\S\+#\1$FREQ_TGA#" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg

        # Set translation_table in AUGUSTUS parameters (needed for non-standard genetic codes)
        if [ "1" != "1" ]; then
            if grep -q "^translation_table" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg; then
                sed -i "s#^translation_table\s\+\S\+#translation_table 1#" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg
            else
                echo "translation_table 1" >> /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg
            fi
            echo "[INFO] Set translation_table to 1 in AUGUSTUS parameters" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        fi

        echo "[INFO] Successfully updated stop codon frequencies in parameters" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Verify the changes
        echo "[INFO] Verifying parameter changes:" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        grep -E "^(stopCodonExcludedFromCDS|/Constant/.*prob|translation_table)" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        echo "[INFO] =======================================" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log
        echo "[INFO] AUGUSTUS training completed successfully" | tee -a output/bam_isoseq_proteins_masked/augustus_training.log

        # Report
        REPORT_DIR=output/bam_isoseq_proteins_masked
        source /projects/wenglab/testtube/matthew/manual/braker4/scripts/report_citations.sh
        STOP_CODON_STATUS=$(grep "stopCodonExcludedFromCDS" /projects/wenglab/testtube/matthew/manual/braker4/test_scenarios_local/scenario_07_dual/augustus_config/species/bam_isoseq_proteins_masked/bam_isoseq_proteins_masked_parameters.cfg | awk '{print $2}')
        cite augustus "$REPORT_DIR"
        
