    output: output/bam_isoseq_proteins_masked/braker.longest.gtf, output/bam_isoseq_proteins_masked/braker.longest.aa
    log: logs/bam_isoseq_proteins_masked/longest_isoform/longest_isoform.log
    jobid: 42
